+---
+import BaseLayout from './BaseLayout.astro';
+import Toc from '../components/Toc.astro';
+
+interface Props {
+  title: string;
+  description: string;
+  date: string;
+  lang: 'en' | 'zh';
+  tags: string[];
+  headings: { depth: number; slug: string; text: string }[];
+}
+const { title, description, date, lang, tags, headings } = Astro.props;
+---
+<BaseLayout
+  title={`${title} · Zicong Yang`}
+  description={description}
+  lang={lang === 'zh' ? 'zh-CN' : 'en'}
+  type="article"
+>
+  <Fragment slot="head">
+    <meta property="article:published_time" content={date} />
+    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
+  </Fragment>
+  <div class="post-grid container" style="padding-top:24px">
+    <article>
+      <header class="post-header">
+        <h1>{title}</h1>
+        <div class="post-meta">
+          <time datetime={date}>{date}</time>
+          <span class="lang-badge">{lang === 'zh' ? '中文' : 'EN'}</span>
+          {tags.map((tag) => <span class="lang-badge">{tag}</span>)}
+        </div>
+      </header>
+      <div class="toc-mobile"><Toc headings={headings} /></div>
+      <div class="prose"><slot /></div>
+      <slot name="footer" />
+    </article>
+    <aside><Toc headings={headings} /></aside>
+  </div>
+</BaseLayout>
