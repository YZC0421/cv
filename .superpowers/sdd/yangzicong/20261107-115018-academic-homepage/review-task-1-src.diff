diff --git a/src/components/Header.astro b/src/components/Header.astro
new file mode 100644
index 0000000..056f509
--- /dev/null
+++ b/src/components/Header.astro
@@ -0,0 +1,30 @@
+---
+import ThemeToggle from './ThemeToggle.astro';
+const base = import.meta.env.BASE_URL;
+const path = Astro.url.pathname;
+const links = [
+  { href: `${base}publications`, label: 'Publications' },
+  { href: `${base}work`, label: 'Work' },
+  { href: `${base}blog`, label: 'Writing' },
+  { href: `${base}about`, label: 'About' },
+];
+const trail = path.replace(base, '/');
+const isCurrent = (href: string) => {
+  const target = href.replace(base, '/');
+  return target === '/' ? trail === '/' : trail.startsWith(target);
+};
+---
+<header class="site-header">
+  <div class="inner">
+    <a class="brand" href={base}>Zicong Yang</a>
+    <details class="nav-details">
+      <summary class="nav-toggle">Menu</summary>
+      <nav class="nav">
+        {links.map((link) => (
+          <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>
+        ))}
+      </nav>
+    </details>
+    <ThemeToggle />
+  </div>
+</header>
diff --git a/src/components/ThemeToggle.astro b/src/components/ThemeToggle.astro
new file mode 100644
index 0000000..08739b9
--- /dev/null
+++ b/src/components/ThemeToggle.astro
@@ -0,0 +1,9 @@
+<button id="theme-toggle" type="button" aria-label="Toggle dark mode" class="theme-toggle">◐</button>
+<script is:inline>
+  document.getElementById('theme-toggle')?.addEventListener('click', () => {
+    const root = document.documentElement;
+    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
+    root.dataset.theme = next;
+    localStorage.setItem('theme', next);
+  });
+</script>
diff --git a/src/layouts/BaseLayout.astro b/src/layouts/BaseLayout.astro
new file mode 100644
index 0000000..21ba11d
--- /dev/null
+++ b/src/layouts/BaseLayout.astro
@@ -0,0 +1,46 @@
+---
+import '../styles/global.css';
+import Header from '../components/Header.astro';
+import Footer from '../components/Footer.astro';
+
+interface Props {
+  title: string;
+  description: string;
+  lang?: string;
+  type?: 'website' | 'article';
+}
+const { title, description, lang = 'en', type = 'website' } = Astro.props;
+const canonical = new URL(Astro.url.pathname, Astro.site);
+const base = import.meta.env.BASE_URL;
+---
+<!doctype html>
+<html lang={lang}>
+  <head>
+    <meta charset="utf-8" />
+    <meta name="viewport" content="width=device-width, initial-scale=1" />
+    <title>{title}</title>
+    <meta name="description" content={description} />
+    <link rel="canonical" href={canonical} />
+    <link rel="icon" href={`${base}favicon.svg`} />
+    <meta property="og:title" content={title} />
+    <meta property="og:description" content={description} />
+    <meta property="og:type" content={type} />
+    <meta property="og:url" content={canonical} />
+    <slot name="head" />
+    <script is:inline>
+      (() => {
+        const saved = localStorage.getItem('theme');
+        const dark = saved
+          ? saved === 'dark'
+          : window.matchMedia('(prefers-color-scheme: dark)').matches;
+        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
+      })();
+    </script>
+  </head>
+  <body>
+    <a class="skip" href="#main">Skip to content</a>
+    <Header />
+    <main id="main"><slot /></main>
+    <Footer />
+  </body>
+</html>
