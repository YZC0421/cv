diff --git a/src/components/PublicationItem.astro b/src/components/PublicationItem.astro
new file mode 100644
index 0000000..b41de38
--- /dev/null
+++ b/src/components/PublicationItem.astro
@@ -0,0 +1,44 @@
+---
+import BibtexButton from './BibtexButton.astro';
+import { boldSelf, toBibtex } from '../lib/format';
+
+interface Props {
+  pub: any;
+}
+const { pub } = Astro.props;
+const d = pub.data;
+const href = d.url ?? `https://doi.org/${d.doi}`;
+const bibtex =
+  d.bibtex ??
+  toBibtex({
+    title: d.title,
+    authors: d.authors,
+    venue: d.venue,
+    year: d.year,
+    doi: d.doi,
+    type: d.type,
+  });
+const badgeClass =
+  d.indexing === 'Q1'
+    ? 'badge-q1'
+    : d.indexing === 'Q4'
+      ? 'badge-q4'
+      : d.indexing === 'EI'
+        ? 'badge-ei'
+        : 'badge-neutral';
+const indexingLabel = d.indexing === 'EI' ? 'EI indexed' : `JCR ${d.indexing}`;
+const roleLabel = d.role === 'first' ? 'First author' : 'Co-author';
+---
+<li class="pub-item" data-indexing={d.indexing} data-role={d.role} data-year={d.year}>
+  <a class="pub-title" href={href} target="_blank" rel="noopener">{d.title}</a>
+  <div class="pub-meta"><span set:html={boldSelf(d.authors)} /></div>
+  <div class="pub-meta">
+    {d.indexing !== 'none' && <span class={`badge ${badgeClass}`}>{indexingLabel}</span>}
+    <span class="badge badge-neutral">{roleLabel}</span>
+    <span>{d.venueShort ?? d.venue} · {d.year}</span>
+  </div>
+  <div class="pub-actions">
+    <a href={`https://doi.org/${d.doi}`} target="_blank" rel="noopener">DOI</a>
+    <BibtexButton bibtex={bibtex} />
+  </div>
+</li>
diff --git a/src/components/PublicationScripts.astro b/src/components/PublicationScripts.astro
new file mode 100644
index 0000000..533ed56
--- /dev/null
+++ b/src/components/PublicationScripts.astro
@@ -0,0 +1,16 @@
+<script is:inline>
+  document.querySelectorAll('.copy-btn').forEach((btn) => {
+    btn.addEventListener('click', async () => {
+      const text = btn.dataset.bibtex ?? '';
+      try {
+        await navigator.clipboard.writeText(text);
+        btn.textContent = 'Copied';
+        setTimeout(() => {
+          btn.textContent = 'Copy BibTeX';
+        }, 1500);
+      } catch {
+        btn.textContent = 'Select BibTeX below';
+      }
+    });
+  });
+</script>
diff --git a/src/pages/publications.astro b/src/pages/publications.astro
new file mode 100644
index 0000000..07ebdcc
--- /dev/null
+++ b/src/pages/publications.astro
@@ -0,0 +1,54 @@
+---
+import BaseLayout from '../layouts/BaseLayout.astro';
+import PublicationItem from '../components/PublicationItem.astro';
+import PublicationScripts from '../components/PublicationScripts.astro';
+import { getCollection } from 'astro:content';
+import { sortPublications } from '../lib/publications';
+
+const pubs = sortPublications(await getCollection('publications'));
+const years = [...new Set(pubs.map((p) => p.data.year))].sort((a, b) => b - a);
+---
+<BaseLayout
+  title="Publications · Zicong Yang"
+  description="Peer-reviewed publications on medical signal processing and computer vision."
+>
+  <div class="container measure" style="padding-top:40px">
+    <h1>Publications</h1>
+    <p class="muted">Peer-reviewed journal and conference papers. {pubs.length} entries.</p>
+
+    <div class="filters" role="group" aria-label="Filter publications">
+      <button type="button" data-filter="all" aria-pressed="true">All</button>
+      <button type="button" data-filter="first" aria-pressed="false">First author</button>
+      <button type="button" data-filter="Q1" aria-pressed="false">JCR Q1</button>
+      <button type="button" data-filter="EI" aria-pressed="false">EI</button>
+      {years.map((year) => (
+        <button type="button" data-filter={String(year)} aria-pressed="false">{year}</button>
+      ))}
+    </div>
+
+    <ul class="pub-list" id="pub-list">
+      {pubs.map((pub) => <PublicationItem pub={pub} />)}
+    </ul>
+  </div>
+
+  <PublicationScripts />
+
+  <script is:inline>
+    const buttons = document.querySelectorAll('.filters button');
+    const items = document.querySelectorAll('#pub-list .pub-item');
+    buttons.forEach((btn) => {
+      btn.addEventListener('click', () => {
+        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
+        const filter = btn.dataset.filter;
+        items.forEach((item) => {
+          const match =
+            filter === 'all' ||
+            item.dataset.role === filter ||
+            item.dataset.indexing === filter ||
+            item.dataset.year === filter;
+          item.hidden = !match;
+        });
+      });
+    });
+  </script>
+</BaseLayout>
