@@ -0,0 +1,99 @@
+import { mkdir, writeFile } from 'node:fs/promises';
+
+const OUT = 'scripts/out';
+const targets = [
+  { key: 'scientific-reports-2024', doi: '10.1038/s41598-024-71700-z' },
+  { key: 'cisse-2024', doi: '10.1007/978-3-031-57037-7_7' },
+  { key: 'mst-2025', doi: '10.1088/1361-6501/ae10d3' },
+  {
+    key: 'cvidl-2024-wheat',
+    title:
+      'Wheat Disease Recognition Based on a Fusion Model with Improved Spatial and Channel Reconstruction Convolution Combined with Contextual Transformer',
+  },
+  {
+    key: 'cvidl-2024-garbage',
+    title: 'Enhanced and improved garbage identification and classification of YOLOV5 based on data',
+  },
+  { key: 'ipmlp-2024', doi: '10.1145/3700906.3700946' },
+];
+
+const fetchJson = async (url) => {
+  const res = await fetch(url, {
+    headers: { 'User-Agent': 'cv-site-build/1.0 (mailto:402641915@qq.com)' },
+  });
+  if (!res.ok) throw new Error(`${res.status} ${url}`);
+  return res.json();
+};
+
+const lookup = async (target) => {
+  if (target.doi) {
+    const json = await fetchJson(`https://api.crossref.org/works/${encodeURIComponent(target.doi)}`);
+    return json.message;
+  }
+  const q = encodeURIComponent(target.title);
+  const json = await fetchJson(`https://api.crossref.org/works?query.bibliographic=${q}&rows=1`);
+  return json.message.items?.[0];
+};
+
+const toEntry = (item) => {
+  const authors = (item.author ?? []).map((a) => [a.given, a.family].filter(Boolean).join(' '));
+  const issued = item.issued?.['date-parts']?.[0] ?? [];
+  const year = issued[0];
+  const month = String(issued[1] ?? 1).padStart(2, '0');
+  const day = String(issued[2] ?? 1).padStart(2, '0');
+  const type = item.type === 'proceedings-article' ? 'conference' : 'journal';
+  return {
+    title: (item.title ?? [''])[0].replace(/\s+/g, ' ').trim(),
+    authors,
+    venue: (item['container-title'] ?? [''])[0],
+    year,
+    doi: item.DOI,
+    url: item.URL,
+    type,
+    date: `${year}-${month}-${day}`,
+  };
+};
+
+await mkdir(OUT, { recursive: true });
+const review = ['# 论文元数据核对表', ''];
+
+for (const target of targets) {
+  try {
+    const item = await lookup(target);
+    if (!item) throw new Error('no crossref match');
+    const entry = toEntry(item);
+    const fm = [
+      '---',
+      `title: ${JSON.stringify(entry.title)}`,
+      'authors:',
+      ...entry.authors.map((a) => `  - ${JSON.stringify(a)}`),
+      `venue: ${JSON.stringify(entry.venue)}`,
+      `year: ${entry.year}`,
+      `type: ${entry.type}`,
+      'indexing: none',
+      'role: other',
+      `doi: ${JSON.stringify(entry.doi)}`,
+      `url: ${JSON.stringify(entry.url)}`,
+      'selected: false',
+      `date: ${entry.date}`,
+      '---',
+      '',
+    ].join('\n');
+    await writeFile(`${OUT}/${target.key}.md`, fm, 'utf8');
+    review.push(
+      `## ${target.key}`,
+      '',
+      `- 标题：${entry.title}`,
+      `- 作者：${entry.authors.join(', ')}`,
+      `- 出处：${entry.venue} (${entry.year})`,
+      `- DOI：${entry.doi}`,
+      ''
+    );
+  } catch (error) {
+    review.push(`## ${target.key}`, '', `- 失败：${error.message}`, '');
+    console.warn(`[warn] ${target.key}: ${error.message}`);
+  }
+}
+
+await writeFile(`${OUT}/review.md`, review.join('\n'), 'utf8');
+console.log(`written to ${OUT}/`);
diff --git a/scripts/verify-build.mjs b/scripts/verify-build.mjs
new file mode 100644
index 0000000..660b2e2
--- /dev/null
+++ b/scripts/verify-build.mjs
@@ -0,0 +1,94 @@
+import { readFile, access, readdir } from 'node:fs/promises';
+import { constants } from 'node:fs';
+
+const checks = [];
+
+const must = async (path, label) => {
+  try {
+    await access(path, constants.R_OK);
+    checks.push([label, true]);
+  } catch {
+    checks.push([label, false]);
+  }
+};
+
+const read = async (path) => {
+  try {
+    return await readFile(path, 'utf8');
+  } catch {
+    checks.push([`read ${path}`, false]);
+    return '';
+  }
+};
+
+const countFiles = async (dir, ext) =>
+  (await readdir(dir)).filter((file) => file.endsWith(ext)).length;
+
+const countDirs = async (dir) =>
+  (await readdir(dir, { withFileTypes: true })).filter((entry) => entry.isDirectory()).length;
+
+const indexRoutes = [
+  'dist/index.html',
+  'dist/publications/index.html',
+  'dist/work/index.html',
+  'dist/blog/index.html',
+  'dist/about/index.html',
+  'dist/about/zh/index.html',
+  'dist/404.html',
+  'dist/rss.xml',
+  'dist/sitemap-index.xml',
+  'dist/sitemap-0.xml',
+  'dist/robots.txt',
+  'dist/favicon.svg',
+  'dist/CV.html',
+];
+
+for (const route of indexRoutes) await must(route, route);
+
+const publicationFiles = await countFiles('src/content/publications', '.md');
+const workFiles = await countFiles('src/content/work', '.md');
+const workDetails = await countDirs('dist/work');
+const postDetails = await countDirs('dist/blog');
+
+checks.push(['work detail pages match content files', workDetails === workFiles]);
+checks.push(['blog has at least one post page', postDetails >= 1]);
+
+const home = await read('dist/index.html');
+checks.push(['home shows 3 publications', (home.match(/class="pub-item"/g) ?? []).length === 3]);
+checks.push(['home shows 3 work cards', (home.match(/class="work-card"/g) ?? []).length === 3]);
+
+const publications = await read('dist/publications/index.html');
+checks.push([
+  'publications count matches content files',
+  (publications.match(/class="pub-item"/g) ?? []).length === publicationFiles,
+]);
+checks.push([
+  'every publication links a doi',
+  (publications.match(/doi\.org\//g) ?? []).length >= publicationFiles,
+]);
+
+const rss = await read('dist/rss.xml');
+checks.push(['rss has items', rss.includes('<item>')]);
+checks.push(['rss channel link includes base', /<link>[^<]*\/cv\/<\/link>/.test(rss)]);
+
+const about = await read('dist/about/index.html');
+checks.push(['about has h1', /<h1[^>]*>About<\/h1>/.test(about)]);
+checks.push(['about declares alternate zh-CN', /rel="alternate" hreflang="zh-CN"/.test(about)]);
+checks.push(['about declares alternate en', /rel="alternate" hreflang="en"/.test(about)]);
+checks.push(['about declares x-default', /hreflang="x-default"/.test(about)]);
+
+const notFound = await read('dist/404.html');
+checks.push(['404 is noindex', /name="robots"[^>]*noindex/.test(notFound)]);
+
+const sitemap = await read('dist/sitemap-0.xml');
+checks.push(['sitemap excludes 404', !sitemap.includes('/404')]);
+checks.push(['sitemap excludes drafts', !sitemap.includes('/blog/draft-check/')]);
+
+const failed = checks.filter(([, ok]) => !ok);
+for (const [label, ok] of checks) console.log(`${ok ? 'ok  ' : 'FAIL'} ${label}`);
+
+if (failed.length) {
+  console.error(`\n${failed.length} check(s) failed`);
+  process.exit(1);
+}
+console.log('\nall checks passed');
