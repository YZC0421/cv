@@ -0,0 +1,83 @@
+---
+import '../styles/global.css';
+import Header from '../components/Header.astro';
+import Footer from '../components/Footer.astro';
+import PublicationScripts from '../components/PublicationScripts.astro';
+import { withBase } from '../lib/url';
+
+interface Props {
+  title: string;
+  description: string;
+  lang?: string;
+  type?: 'website' | 'article';
+  langLink?: { href: string; label: string; lang: string };
+  profilePage?: boolean;
+  noindex?: boolean;
+}
+const {
+  title,
+  description,
+  lang = 'en',
+  type = 'website',
+  langLink,
+  profilePage = false,
+  noindex = false,
+} = Astro.props;
+const canonical = new URL(Astro.url.pathname.replace(/\/?$/, '/'), Astro.site);
+const personId = `${new URL(withBase(), Astro.site).href}#person`;
+const profile = {
+  '@context': 'https://schema.org',
+  '@graph': [
+    { '@type': 'ProfilePage', mainEntity: { '@id': personId } },
+    {
+      '@type': 'Person',
+      '@id': personId,
+      name: 'Zicong Yang',
+      jobTitle: 'Software Engineer',
+      sameAs: [
+        'https://scholar.google.com/citations?user=0Ynn-awAAAAJ',
+        'https://orcid.org/0009-0001-0948-3606',
+        'https://github.com/YZC0421',
+      ],
+    },
+  ],
+};
+---
+<!doctype html>
+<html lang={lang}>
+  <head>
+    <meta charset="utf-8" />
+    <meta name="viewport" content="width=device-width, initial-scale=1" />
+    <title>{title}</title>
+    <meta name="description" content={description} />
+    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
+    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
+    <meta property="og:title" content={title} />
+    <meta property="og:description" content={description} />
+    <meta property="og:type" content={type} />
+    <meta property="og:url" content={canonical} />
+    <slot name="head" />
+    {profilePage && <script type="application/ld+json" set:html={JSON.stringify(profile)} />}
+    <script is:inline>
+      (() => {
+        let saved = null;
+        try {
+          saved = localStorage.getItem('theme');
+        } catch {
+          /* storage unavailable */
+        }
+        const dark = saved
+          ? saved === 'dark'
+          : window.matchMedia('(prefers-color-scheme: dark)').matches;
+        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
+      })();
+    </script>
+  </head>
+  <body>
+    <a class="skip" href="#main">Skip to content</a>
+    <Header langLink={langLink} />
+    <main id="main" tabindex="-1"><slot /></main>
+    <Footer />
+    <PublicationScripts />
+  </body>
+</html>
diff --git a/src/layouts/PostLayout.astro b/src/layouts/PostLayout.astro
