+}
+
+@page { size: A4; margin: 16mm; }
+
+@media print {
+  :root,
+  [data-theme='dark'] {
+    --bg: #fff;
+    --bg-soft: #fff;
+    --fg: #000;
+    --muted: #333;
+    --border: #999;
+    --accent: #000;
