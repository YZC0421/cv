--- /dev/null
+++ b/tests/posts.test.ts
@@ -0,0 +1,32 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { visiblePosts } from '../src/lib/posts.ts';
+
+const make = (over: Record<string, unknown>) =>
+  ({
+    id: String(over.id ?? Math.random()),
+    data: { title: 'T', date: '2026-01-01', lang: 'zh', tags: ['t'], summary: 's', draft: false, ...over },
+  }) as any;
+
+test('visiblePosts filters drafts and future dates', () => {
+  const posts = [
+    make({ id: 'a', date: '2026-01-01' }),
+    make({ id: 'b', draft: true }),
+    make({ id: 'c', date: '2099-01-01' }),
+  ];
+  assert.deepEqual(
+    visiblePosts(posts, '2026-11-07').map((post: any) => post.id),
+    ['a']
+  );
+});
+
+test('visiblePosts sorts newest first', () => {
+  const posts = [
+    make({ id: 'old', date: '2025-01-01' }),
+    make({ id: 'new', date: '2026-06-01' }),
+  ];
+  assert.deepEqual(
+    visiblePosts(posts, '2026-11-07').map((post: any) => post.id),
+    ['new', 'old']
+  );
+});
diff --git a/tests/publications.test.ts b/tests/publications.test.ts
new file mode 100644
index 0000000..fe8299d
--- /dev/null
+++ b/tests/publications.test.ts
@@ -0,0 +1,51 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { sortPublications, selectHomepage } from '../src/lib/publications.ts';
+
+const make = (over: Record<string, unknown>) =>
+  ({
+    id: String(over.id ?? Math.random()),
+    data: {
+      title: 'T',
+      authors: ['Zicong Yang'],
+      venue: 'V',
+      year: 2024,
+      type: 'journal',
+      indexing: 'Q1',
+      role: 'other',
+      doi: '10.1/x',
+      selected: false,
+      date: '2024-01-01',
+      ...over,
+    },
+  }) as any;
+
+test('sortPublications orders by date desc, then role rank', () => {
+  const a = make({ id: 'a', date: '2024-01-01' });
+  const b = make({ id: 'b', date: '2025-01-01' });
+  const c = make({ id: 'c', date: '2025-01-01', role: 'first' });
+  assert.deepEqual(sortPublications([a, b, c]).map((p: any) => p.id), ['c', 'b', 'a']);
+});
+
+test('selectHomepage prefers selected, then first author, then newest', () => {
+  const selected = make({ id: 'sel', selected: true, date: '2020-01-01' });
+  const first = make({ id: 'first', role: 'first', date: '2025-01-01' });
+  const newestOther = make({ id: 'new', date: '2025-06-01' });
+  const old = make({ id: 'old', date: '2019-01-01' });
+  const result = selectHomepage([selected, first, newestOther, old]);
+  assert.deepEqual(result.map((p: any) => p.id), ['sel', 'first', 'new']);
+});
+
+test('selectHomepage returns all entries when fewer than three', () => {
+  const one = make({ id: 'one' });
+  assert.equal(selectHomepage([one]).length, 1);
+});
+
+test('selectHomepage deduplicates an entry that is both selected and first-authored', () => {
+  const both = make({ id: 'both', selected: true, role: 'first', date: '2025-01-01' });
+  const other = make({ id: 'other', date: '2024-01-01' });
+  const third = make({ id: 'third', date: '2023-01-01' });
+  const result = selectHomepage([both, other, third]);
+  assert.deepEqual(result.map((p: any) => p.id), ['both', 'other', 'third']);
+  assert.equal(new Set(result.map((p: any) => p.id)).size, 3);
+});
diff --git a/tests/schema.test.ts b/tests/schema.test.ts
new file mode 100644
index 0000000..18303b0
--- /dev/null
+++ b/tests/schema.test.ts
@@ -0,0 +1,86 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { publicationSchema, workSchema, blogSchema } from '../src/lib/schema.ts';
+
+const paper = {
+  title: 'A paper',
+  authors: ['Zicong Yang', 'Someone Else'],
+  venue: 'Scientific Reports',
+  year: 2024,
+  type: 'journal' as const,
+  indexing: 'Q1' as const,
+  role: 'first' as const,
+  doi: '10.1038/s41598-024-71700-z',
+  date: '2024-09-01',
+};
+
+test('publication accepts a valid entry', () => {
+  assert.equal(publicationSchema.safeParse(paper).success, true);
+});
+
+test('publication rejects a missing doi', () => {
+  const { doi, ...rest } = paper;
+  const result = publicationSchema.safeParse(rest);
+  assert.equal(result.success, false);
+});
+
+test('publication rejects a year below 2000', () => {
+  assert.equal(publicationSchema.safeParse({ ...paper, year: 1999 }).success, false);
+});
+
+test('work rejects start later than end', () => {
+  const job = {
+    title: 'Software Engineer',
+    org: 'Acme',
+    kind: 'experience' as const,
+    role: 'Engineer',
+    start: '2025-09',
+    end: '2025-01',
+    summary: 'Built things.',
+    highlights: ['Did work'],
+  };
+  assert.equal(workSchema.safeParse(job).success, false);
+});
+
+test('work accepts present as end', () => {
+  const job = {
+    title: 'Software Engineer',
+    org: 'Acme',
+    kind: 'experience' as const,
+    role: 'Engineer',
+    start: '2025-09',
+    end: 'present',
+    summary: 'Built things.',
+    highlights: ['Did work'],
+  };
+  assert.equal(workSchema.safeParse(job).success, true);
+});
+
+test('blog rejects summary longer than 160 chars', () => {
+  const post = {
+    title: 'Post',
+    date: '2026-01-01',
+    lang: 'zh' as const,
+    tags: ['astro'],
+    summary: 'x'.repeat(161),
+  };
+  assert.equal(blogSchema.safeParse(post).success, false);
+});
+
+test('publication rejects empty authors', () => {
+  assert.equal(publicationSchema.safeParse({ ...paper, authors: [] }).success, false);
+});
+
+test('publication rejects a year above 2100', () => {
+  assert.equal(publicationSchema.safeParse({ ...paper, year: 2101 }).success, false);
+});
+
+test('publication rejects an invalid date format', () => {
+  assert.equal(publicationSchema.safeParse({ ...paper, date: '2024/09/01' }).success, false);
+});
+
+test('publication ignores unknown frontmatter fields', () => {
+  const result = publicationSchema.safeParse({ ...paper, unknownField: 'ignored' });
+  assert.equal(result.success, true);
+  assert.equal('unknownField' in (result.success ? result.data : {}), false);
+});
