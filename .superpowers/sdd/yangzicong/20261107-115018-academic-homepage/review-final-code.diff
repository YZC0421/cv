+  border: 0;
+}
+[data-footnotes] { margin-top: 40px; font-size: 0.9rem; color: var(--muted); }
+
+.page-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 12px; margin-bottom: 8px; }
+.lang-link { font-size: 0.82rem; color: var(--muted); }
