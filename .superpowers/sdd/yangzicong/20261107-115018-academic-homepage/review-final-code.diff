+  .site-header, .site-footer, .skip, .about-actions, .theme-toggle { display: none !important; }
+  body { background: #fff; color: #000; font-size: 11pt; }
+  .container { max-width: none; padding: 0; }
+  a { color: #000; text-decoration: none; }
