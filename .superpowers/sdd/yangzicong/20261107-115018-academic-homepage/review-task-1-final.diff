+:root {
+  --bg: #ffffff;
+  --bg-soft: #f8fafc;
+  --fg: #111827;
+  --muted: #64748b;
+  --border: #e2e8f0;
+  --accent: #1d4ed8;
+  --q1-bg: #fffbeb;
+  --q1-fg: #b45309;
+  --q4-bg: #f3e8ff;
+  --q4-fg: #7e22ce;
+  --ei-bg: #ecfdf5;
+  --ei-fg: #047857;
+  --font-serif: "Source Serif 4", Georgia, "Songti SC", serif;
+  --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans SC", sans-serif;
+  --measure: 720px;
+  --wide: 1120px;
+  color-scheme: light;
+}
+
+[data-theme='dark'] {
+  --bg: #0b1120;
+  --bg-soft: #111a2e;
+  --fg: #e5e7eb;
+  --muted: #94a3b8;
+  --border: #1f2a3d;
+  --accent: #60a5fa;
+  --q1-bg: #2a1f06;
+  --q1-fg: #fbbf24;
+  --q4-bg: #241432;
+  --q4-fg: #d8b4fe;
+  --ei-bg: #052e22;
+  --ei-fg: #6ee7b7;
+  color-scheme: dark;
+}
+
+* { box-sizing: border-box; }
+
+body {
+  margin: 0;
+  background: var(--bg);
+  color: var(--fg);
+  font-family: var(--font-sans);
+  font-size: 16px;
+  line-height: 1.7;
+  transition: background-color 150ms ease, color 150ms ease;
+}
+
+a { color: var(--accent); text-decoration: none; }
+a:hover { text-decoration: underline; }
+:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
+
+h1, h2, h3 { font-family: var(--font-serif); line-height: 1.25; margin: 0; }
+h1 { font-size: 2.25rem; letter-spacing: -0.02em; }
+h2 { font-size: 1.5rem; }
+h3 { font-size: 1.125rem; }
+
+.container { width: 100%; max-width: var(--wide); margin: 0 auto; padding: 0 24px; }
+.measure { max-width: var(--measure); }
+.muted { color: var(--muted); }
+.rule { border: 0; border-top: 1px solid var(--border); margin: 0; }
+
+.skip {
+  position: absolute;
+  left: -9999px;
+  top: 0;
+  background: var(--bg);
+  padding: 8px 12px;
+  z-index: 100;
+}
+.skip:focus { left: 8px; }
+
+.site-header {
+  border-bottom: 1px solid var(--border);
+  position: sticky;
+  top: 0;
+  background: color-mix(in srgb, var(--bg) 92%, transparent);
+  backdrop-filter: blur(8px);
+  z-index: 50;
+}
+.site-header .inner {
+  max-width: var(--wide);
+  margin: 0 auto;
+  padding: 14px 24px;
+  display: flex;
+  align-items: center;
+  gap: 24px;
+}
+.brand { font-family: var(--font-serif); font-size: 1.05rem; font-weight: 600; color: var(--fg); }
+.desktop-nav { margin-left: auto; }
+.nav-details { display: none; }
+.nav-details > summary { list-style: none; }
+.nav-details > summary::-webkit-details-marker { display: none; }
+.nav { display: flex; gap: 18px; font-size: 0.9rem; }
+.nav a { color: var(--muted); }
+.nav a[aria-current='page'] { color: var(--fg); font-weight: 600; }
+.nav-toggle { display: none; cursor: pointer; background: none; border: 1px solid var(--border); border-radius: 6px; padding: 4px 10px; color: var(--fg); font: inherit; }
+.theme-toggle { background: none; border: 1px solid var(--border); border-radius: 6px; padding: 2px 8px; color: var(--muted); cursor: pointer; font: inherit; }
+.site-footer { border-top: 1px solid var(--border); margin-top: 72px; padding: 28px 0; color: var(--muted); font-size: 0.85rem; }
+
+@media (max-width: 767px) {
+  .desktop-nav { display: none; }
+  .nav-details { display: block; position: relative; margin-left: auto; }
+  .nav-toggle { display: block; }
+  .nav-details > .nav { display: none; }
+  .nav-details[open] > .nav {
+    display: flex;
+    flex-direction: column;
+    position: absolute;
+    right: 0;
+    top: calc(100% + 8px);
+    min-width: 180px;
+    padding: 16px;
+    background: var(--bg);
+    border: 1px solid var(--border);
+    border-radius: 8px;
+    z-index: 60;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *, *::before, *::after { transition: none !important; animation: none !important; }
+}
