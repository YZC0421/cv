---
import BaseLayout from './BaseLayout.astro';
import Toc from '../components/Toc.astro';
import { withBase } from '../lib/url';

interface Props {
  title: string;
  description: string;
  date: string;
  lang: 'en' | 'zh';
  tags: string[];
  headings: { depth: number; slug: string; text: string }[];
  readingTime: number;
}
const { title, description, date, lang, tags, headings, readingTime } = Astro.props;
const readingLabel = lang === 'zh' ? `约 ${readingTime} 分钟` : `${readingTime} min read`;
const hasToc = headings.some(
  (heading) => (heading.depth === 2 || heading.depth === 3) && heading.slug !== 'footnote-label'
);
---
<BaseLayout
  title={`${title} · Zicong Yang`}
  description={description}
  lang={lang === 'zh' ? 'zh-CN' : 'en'}
  type="article"
>
  <Fragment slot="head">
    <meta property="article:published_time" content={date} />
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
  </Fragment>
  <div class="post-grid container" style="padding-top:24px">
    <article>
      <header class="post-header">
        <h1>{title}</h1>
        <div class="post-meta">
          <time datetime={date}>{date}</time>
          <span class="lang-badge">{lang === 'zh' ? '中文' : 'EN'}</span>
          <span>{readingLabel}</span>
          {tags.map((tag) => (
            <a class="lang-badge" href={withBase(`blog/tag/${tag}`)}>{tag}</a>
          ))}
        </div>
      </header>
      {hasToc && (
        <details class="toc-mobile">
          <summary>Table of contents</summary>
          <Toc headings={headings} />
        </details>
      )}
      <div class="prose"><slot /></div>
      <slot name="footer" />
    </article>
    <aside class="toc-aside"><Toc headings={headings} /></aside>
  </div>
</BaseLayout>
