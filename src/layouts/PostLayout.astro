---
import BaseLayout from './BaseLayout.astro';
import Toc from '../components/Toc.astro';
import 'katex/dist/katex.min.css';
import { withBase } from '../lib/url';
import { categoryLabel } from '../lib/blog';
import { localeUrl } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  date: string;
  lang: 'en' | 'zh';
  tags: string[];
  headings: { depth: number; slug: string; text: string }[];
  readingTime: number;
  cover?: string;
  draft?: boolean;
  noindex?: boolean;
  updated?: string;
  changelog?: { date: string; note: string }[];
  staleSince?: string;
  alternates?: { lang: 'en' | 'zh'; href: string }[];
  langSwitchHref?: string | null;
  canonicalPath?: string;
  hasMermaid?: boolean;
  ogImagePath?: string;
  category?: string;
  words?: number;
}
const {
  title,
  description,
  date,
  lang,
  tags,
  headings,
  readingTime,
  cover,
  draft = false,
  noindex = false,
  updated,
  changelog = [],
  staleSince,
  alternates,
  langSwitchHref,
  canonicalPath,
  hasMermaid = false,
  ogImagePath = 'og.png',
  category,
  words = 0,
} = Astro.props;
const readingLabel = lang === 'zh' ? `约 ${readingTime} 分钟` : `${readingTime} min read`;
const tocLabel = lang === 'zh' ? '目录' : 'Table of contents';
const draftLabel =
  lang === 'zh'
    ? '草稿预览：未发布，不进入列表、RSS 与 sitemap。'
    : 'Draft preview — not published, excluded from lists, RSS and sitemap.';
const hasToc = headings.some(
  (heading) => (heading.depth === 2 || heading.depth === 3) && heading.slug !== 'footnote-label'
);
const labels =
  lang === 'zh'
    ? {
        updated: '更新于',
        changelog: '变更记录',
        stale: (date: string) => `本文最后确认于 ${date}，超过 12 个月未复查，部分内容可能已过时。`,
      }
    : {
        updated: 'Updated',
        changelog: 'Changelog',
        stale: (date: string) =>
          `Last verified ${date}. This post is over 12 months old and may be out of date.`,
      };
const ogUrl = new URL(withBase(ogImagePath), Astro.site).href;
const blogUrl = new URL(localeUrl('blog', lang), Astro.site).href;
const homeUrl = new URL(withBase(), Astro.site).href;
const article = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date,
  dateModified: updated ?? date,
  image: ogUrl,
  inLanguage: lang === 'zh' ? 'zh-CN' : 'en',
  wordCount: words,
  articleSection: category ? categoryLabel(category, lang) : undefined,
  isPartOf: { '@type': 'Blog', name: 'Zicong Yang · Writing', url: blogUrl },
  keywords: tags.join(', '),
  author: { '@type': 'Person', name: 'Zicong Yang' },
  mainEntityOfPage: Astro.url.href,
};
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: lang === 'zh' ? '首页' : 'Home', item: homeUrl },
    {
      '@type': 'ListItem',
      position: 2,
      name: lang === 'zh' ? '博客' : 'Writing',
      item: blogUrl,
    },
    { '@type': 'ListItem', position: 3, name: title, item: Astro.url.href },
  ],
};
---
<BaseLayout
  title={`${title} · Zicong Yang`}
  description={description}
  lang={lang === 'zh' ? 'zh-CN' : 'en'}
  type="article"
  noindex={noindex || draft}
  alternates={alternates}
  langSwitchHref={langSwitchHref}
  canonicalPath={canonicalPath}
  ogImagePath={ogImagePath}
  ogImageAlt={title}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={date} />
    <meta property="article:modified_time" content={updated ?? date} />
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <script type="application/ld+json" set:html={JSON.stringify(article)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
  </Fragment>
  <div class="post-grid container" style="padding-top:24px">
    <article>
      {draft && (
        <p class="draft-banner" role="status">{draftLabel}</p>
      )}
      <header class="post-header">
        <h1>{title}</h1>
        <div class="post-meta">
          <time datetime={date}>{date}</time>
          {updated && (
            <>
              <span>·</span>
              <time datetime={updated}>{labels.updated} {updated}</time>
            </>
          )}
          <span class="lang-badge">{lang === 'zh' ? '中文' : 'EN'}</span>
          <span>{readingLabel}</span>
          {tags.map((tag) => (
            <a class="tag-badge" href={localeUrl(`blog/tag/${encodeURIComponent(tag)}`, lang)}>
              {tag}
            </a>
          ))}
        </div>
      </header>
      {staleSince && (
        <p class="stale-banner" role="status">{labels.stale(staleSince)}</p>
      )}
      {cover && (
        <img
          class="post-cover"
          src={withBase(cover)}
          alt={lang === 'zh' ? `${title} 封面图` : `Cover image for ${title}`}
          loading="lazy"
        />
      )}
      {hasToc && (
        <details class="toc-mobile">
          <summary>{tocLabel}</summary>
          <Toc headings={headings} />
        </details>
      )}
      <div class="prose"><slot /></div>
      {changelog.length > 0 && (
        <details class="post-changelog">
          <summary>{labels.changelog}（{changelog.length}）</summary>
          <ul>
            {changelog.map((entry) => (
              <li><time datetime={entry.date}>{entry.date}</time> {entry.note}</li>
            ))}
          </ul>
        </details>
      )}
      <slot name="footer" />
    </article>
    <aside class="toc-aside"><Toc headings={headings} /></aside>
  </div>

  {hasMermaid && (
    <script>
      (async () => {
        const blocks = document.querySelectorAll('pre[data-language="mermaid"]');
        if (blocks.length === 0) return;
        const { default: mermaid } = await import('mermaid');
        mermaid.initialize({
          startOnLoad: false,
          theme: document.documentElement.dataset.theme === 'dark' ? 'dark' : 'default',
        });
        for (const block of blocks) {
          const source = block.textContent ?? '';
          try {
            const { svg } = await mermaid.render(
              `mermaid-${Math.random().toString(36).slice(2)}`,
              source
            );
            const title = block.getAttribute('data-code-title') ?? '';
            const figure = document.createElement('figure');
            figure.className = 'mermaid-figure';
            figure.setAttribute('role', 'img');
            figure.setAttribute('aria-label', title || 'Mermaid diagram');
            figure.innerHTML = svg;
            if (title) {
              const caption = document.createElement('figcaption');
              caption.textContent = title;
              figure.appendChild(caption);
            }
            block.replaceWith(figure);
          } catch {
            block.classList.add('mermaid-error');
          }
        }
      })();
    </script>
  )}
</BaseLayout>
