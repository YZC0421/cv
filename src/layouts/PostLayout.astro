---
import BaseLayout from './BaseLayout.astro';
import Toc from '../components/Toc.astro';
import { withBase } from '../lib/url';

interface Props {
  title: string;
  description: string;
  date: string;
  lang: 'en' | 'zh';
  tags: string[];
  headings: { depth: number; slug: string; text: string }[];
  readingTime: number;
  cover?: string;
}
const { title, description, date, lang, tags, headings, readingTime, cover } = Astro.props;
const readingLabel = lang === 'zh' ? `约 ${readingTime} 分钟` : `${readingTime} min read`;
const tocLabel = lang === 'zh' ? '目录' : 'Table of contents';
const hasToc = headings.some(
  (heading) => (heading.depth === 2 || heading.depth === 3) && heading.slug !== 'footnote-label'
);
const article = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date,
  keywords: tags.join(', '),
  author: { '@type': 'Person', name: 'Zicong Yang' },
  mainEntityOfPage: Astro.url.href,
};
---
<BaseLayout
  title={`${title} · Zicong Yang`}
  description={description}
  lang={lang === 'zh' ? 'zh-CN' : 'en'}
  type="article"
>
  <Fragment slot="head">
    <meta property="article:published_time" content={date} />
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <script type="application/ld+json" set:html={JSON.stringify(article)} />
  </Fragment>
  <div class="post-grid container" style="padding-top:24px">
    <article>
      <header class="post-header">
        <h1>{title}</h1>
        <div class="post-meta">
          <time datetime={date}>{date}</time>
          <span class="lang-badge">{lang === 'zh' ? '中文' : 'EN'}</span>
          <span>{readingLabel}</span>
          {tags.map((tag) => (
            <a class="tag-badge" href={withBase(`blog/tag/${encodeURIComponent(tag)}`)}>{tag}</a>
          ))}
        </div>
      </header>
      {cover && <img class="post-cover" src={withBase(cover)} alt="" loading="lazy" />}
      {hasToc && (
        <details class="toc-mobile">
          <summary>{tocLabel}</summary>
          <Toc headings={headings} />
        </details>
      )}
      <div class="prose"><slot /></div>
      <slot name="footer" />
    </article>
    <aside class="toc-aside"><Toc headings={headings} /></aside>
  </div>
</BaseLayout>
