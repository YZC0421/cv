---
import BaseLayout from './BaseLayout.astro';
import Toc from '../components/Toc.astro';
import 'katex/dist/katex.min.css';
import { withBase } from '../lib/url';
import { localeUrl } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  date: string;
  lang: 'en' | 'zh';
  tags: string[];
  headings: { depth: number; slug: string; text: string }[];
  readingTime: number;
  cover?: string;
  draft?: boolean;
  noindex?: boolean;
  alternates?: { lang: 'en' | 'zh'; href: string }[];
  langSwitchHref?: string | null;
  canonicalPath?: string;
  hasMermaid?: boolean;
}
const {
  title,
  description,
  date,
  lang,
  tags,
  headings,
  readingTime,
  cover,
  draft = false,
  noindex = false,
  alternates,
  langSwitchHref,
  canonicalPath,
  hasMermaid = false,
} = Astro.props;
const readingLabel = lang === 'zh' ? `约 ${readingTime} 分钟` : `${readingTime} min read`;
const tocLabel = lang === 'zh' ? '目录' : 'Table of contents';
const draftLabel =
  lang === 'zh'
    ? '草稿预览：未发布，不进入列表、RSS 与 sitemap。'
    : 'Draft preview — not published, excluded from lists, RSS and sitemap.';
const hasToc = headings.some(
  (heading) => (heading.depth === 2 || heading.depth === 3) && heading.slug !== 'footnote-label'
);
const article = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date,
  keywords: tags.join(', '),
  author: { '@type': 'Person', name: 'Zicong Yang' },
  mainEntityOfPage: Astro.url.href,
};
---
<BaseLayout
  title={`${title} · Zicong Yang`}
  description={description}
  lang={lang === 'zh' ? 'zh-CN' : 'en'}
  type="article"
  noindex={noindex || draft}
  alternates={alternates}
  langSwitchHref={langSwitchHref}
  canonicalPath={canonicalPath}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={date} />
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <script type="application/ld+json" set:html={JSON.stringify(article)} />
  </Fragment>
  <div class="post-grid container" style="padding-top:24px">
    <article>
      {draft && (
        <p class="draft-banner" role="status">{draftLabel}</p>
      )}
      <header class="post-header">
        <h1>{title}</h1>
        <div class="post-meta">
          <time datetime={date}>{date}</time>
          <span class="lang-badge">{lang === 'zh' ? '中文' : 'EN'}</span>
          <span>{readingLabel}</span>
          {tags.map((tag) => (
            <a class="tag-badge" href={localeUrl(`blog/tag/${encodeURIComponent(tag)}`, lang)}>
              {tag}
            </a>
          ))}
        </div>
      </header>
      {cover && <img class="post-cover" src={withBase(cover)} alt="" loading="lazy" />}
      {hasToc && (
        <details class="toc-mobile">
          <summary>{tocLabel}</summary>
          <Toc headings={headings} />
        </details>
      )}
      <div class="prose"><slot /></div>
      <slot name="footer" />
    </article>
    <aside class="toc-aside"><Toc headings={headings} /></aside>
  </div>

  {hasMermaid && (
    <script>
      (async () => {
        const blocks = document.querySelectorAll('pre[data-language="mermaid"]');
        if (blocks.length === 0) return;
        const { default: mermaid } = await import('mermaid');
        mermaid.initialize({
          startOnLoad: false,
          theme: document.documentElement.dataset.theme === 'dark' ? 'dark' : 'default',
        });
        for (const block of blocks) {
          const source = block.textContent ?? '';
          try {
            const { svg } = await mermaid.render(
              `mermaid-${Math.random().toString(36).slice(2)}`,
              source
            );
            const figure = document.createElement('div');
            figure.className = 'mermaid-figure';
            figure.innerHTML = svg;
            block.replaceWith(figure);
          } catch {
            block.classList.add('mermaid-error');
          }
        }
      })();
    </script>
  )}
</BaseLayout>
