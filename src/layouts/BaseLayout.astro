---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PublicationScripts from '../components/PublicationScripts.astro';
import CodeCopy from '../components/CodeCopy.astro';
import fontUrl from '../assets/fonts/crimson-pro-latin.woff2?url';
import { site } from '../lib/site';
import { researchAreas } from '../lib/topics';
import { withBase } from '../lib/url';
import type { Lang } from '../i18n/ui';
import { alternateUrl, langFromPath } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  lang?: string;
  type?: 'website' | 'article';
  langLink?: { href: string; label: string; lang: string };
  profilePage?: boolean;
  noindex?: boolean;
  /** Only declare translations that actually exist. */
  alternates?: { lang: 'en' | 'zh'; href: string }[];
  /** `null` means no translation exists; renders a note instead of a dead link. */
  langSwitchHref?: string | null;
  /** Content-relative canonical path, e.g. "zh/blog/some-post". */
  canonicalPath?: string;
}
const {
  title,
  description,
  lang: rawLang,
  type = 'website',
  profilePage = false,
  noindex = false,
  alternates,
  langSwitchHref,
  canonicalPath,
} = Astro.props;

const lang: Lang =
  rawLang === 'zh' || rawLang === 'zh-CN'
    ? 'zh'
    : rawLang === 'en'
      ? 'en'
      : langFromPath(Astro.url.pathname);
const htmlLang = lang === 'zh' ? 'zh-CN' : 'en';
const enHref = new URL(alternateUrl(Astro.url.pathname, 'en'), Astro.site);
const zhHref = new URL(alternateUrl(Astro.url.pathname, 'zh'), Astro.site);
const canonical = canonicalPath
  ? new URL(withBase(canonicalPath), Astro.site)
  : new URL(Astro.url.pathname.replace(/\/?$/, '/'), Astro.site);
const alternateLinks = alternates
  ? [
      ...alternates.map((item) => ({
        hreflang: item.lang === 'zh' ? 'zh-CN' : 'en',
        href: item.href,
        key: item.lang,
      })),
      { hreflang: 'x-default', href: canonical.href, key: 'x-default' },
    ]
  : [
      { hreflang: 'en', href: enHref.href, key: 'en' },
      { hreflang: 'zh-CN', href: zhHref.href, key: 'zh' },
      { hreflang: 'x-default', href: enHref.href, key: 'x-default' },
    ];
const ogImage = new URL(withBase('og.png'), Astro.site);
const personId = `${new URL(withBase(), Astro.site).href}#person`;
const profile = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'ProfilePage', mainEntity: { '@id': personId } },
    {
      '@type': 'Person',
      '@id': personId,
      name: site.name,
      jobTitle: 'Software Engineer',
      sameAs: [site.scholar, site.orcid, site.github],
    },
  ],
};
---
<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex &&
      alternateLinks.map((link) => (
        <link rel="alternate" hreflang={link.hreflang} href={link.href} />
      ))}
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${researchAreas.map((area) => area.name).join(' · ')}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <slot name="head" />
    {profilePage && <script type="application/ld+json" set:html={JSON.stringify(profile)} />}
    <script is:inline>
      (() => {
        let saved = null;
        try {
          saved = localStorage.getItem('theme');
        } catch {
          /* storage unavailable */
        }
        const dark = saved
          ? saved === 'dark'
          : window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      })();
    </script>
  </head>
  <body data-pagefind-ignore={noindex ? '' : undefined}>
    <a class="skip" href="#main">Skip to content</a>
    <Header hideLangSwitch={noindex} langSwitchHref={langSwitchHref} />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
    <PublicationScripts />
    <CodeCopy />
  </body>
</html>
