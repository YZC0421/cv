---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PublicationScripts from '../components/PublicationScripts.astro';
import { site } from '../lib/site';
import { withBase } from '../lib/url';

interface Props {
  title: string;
  description: string;
  lang?: string;
  type?: 'website' | 'article';
  langLink?: { href: string; label: string; lang: string };
  profilePage?: boolean;
  noindex?: boolean;
}
const {
  title,
  description,
  lang = 'en',
  type = 'website',
  langLink,
  profilePage = false,
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, '/'), Astro.site);
const ogImage = new URL(withBase('og.png'), Astro.site);
const personId = `${new URL(withBase(), Astro.site).href}#person`;
const profile = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'ProfilePage', mainEntity: { '@id': personId } },
    {
      '@type': 'Person',
      '@id': personId,
      name: site.name,
      jobTitle: 'Software Engineer',
      sameAs: [site.scholar, site.orcid, site.github],
    },
  ],
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Zicong Yang — Medical Signal Processing and Industrial Visual Inspection"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <slot name="head" />
    {profilePage && <script type="application/ld+json" set:html={JSON.stringify(profile)} />}
    <script is:inline>
      (() => {
        let saved = null;
        try {
          saved = localStorage.getItem('theme');
        } catch {
          /* storage unavailable */
        }
        const dark = saved
          ? saved === 'dark'
          : window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header langLink={langLink} />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
    <PublicationScripts />
  </body>
</html>
