---
import { withBase } from '../lib/url';

interface Props {
  links: { path: string; label: string }[];
  current: string;
}
const { links, current } = Astro.props;
const isCurrent = (path: string) => current.startsWith(`/${path}/`);
---
{links.map((link) => (
  <a href={withBase(link.path)} aria-current={isCurrent(link.path) ? 'page' : undefined}>
    {link.label}
  </a>
))}
