---
import type { Project } from '../lib/projects';
import { categoryLabel, localizedProject, statusLabel } from '../lib/projects';
import { langFromPath, localeUrl } from '../i18n/utils';
import { t } from '../i18n/ui';

interface Props {
  item: Project;
}
const { item } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
const d = localizedProject(item, lang);
const copy = t(lang).projects;
---
<article class="project-card" data-category={item.data.category}>
  <div class="project-card-head">
    <span class="project-category">{categoryLabel(item.data.category, lang)}</span>
    <span class="project-badges">
      {item.data.status !== 'complete' && (
        <span class="status-badge">{statusLabel(item.data.status, lang)}</span>
      )}
      {item.data.private && <span class="status-badge is-private">{copy.private}</span>}
    </span>
  </div>
  <h3><a href={localeUrl(`projects/${item.id}`, lang)}>{d.title}</a></h3>
  <p>{d.summary}</p>
  {d.stack.length > 0 && (
    <div class="stack">
      {d.stack.map((tech) => <span>{tech}</span>)}
    </div>
  )}
  {d.todo && d.todo.length > 0 && <span class="sr-only">{copy.todo}</span>}
</article>
