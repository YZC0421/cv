---
import type { CollectionEntry } from 'astro:content';
import BibtexButton from './BibtexButton.astro';
import { boldSelf, toBibtex } from '../lib/format';
import { topicName } from '../lib/topics';
import { langFromPath, localeUrl } from '../i18n/utils';
import { t } from '../i18n/ui';

interface Props {
  pub: CollectionEntry<'publications'>;
  workTitles?: Record<string, string>;
}
const { pub, workTitles = {} } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
const copy = t(lang).publications;
const d = pub.data;
const href = d.url ?? `https://doi.org/${d.doi}`;
const bibtex = toBibtex({
  title: d.title,
  authors: d.authors,
  venue: d.venue,
  year: d.year,
  doi: d.doi,
  type: d.type,
  volume: d.volume,
  pages: d.pages,
});
const badgeClass =
  d.indexing === 'Q1'
    ? 'badge-q1'
    : d.indexing === 'Q4'
      ? 'badge-q4'
      : d.indexing === 'EI'
        ? 'badge-ei'
        : 'badge-neutral';
const indexingLabel = d.indexing === 'EI' ? 'EI indexed' : `JCR ${d.indexing}`;
const roleLabel = d.role === 'first' ? copy.firstAuthor : (d.authorNote ?? copy.coAuthor);
const relatedWork = d.relatedWork ?? [];
---
<li
  class="pub-item"
  data-role={d.role}
  data-year={d.year}
  data-topics={d.topics.join(' ')}
>
  <div class="pub-main">
    <a class="pub-title" href={href} target="_blank" rel="noopener">{d.title}</a>
    <div class="pub-meta"><span set:html={boldSelf(d.authors)} /></div>
    <div class="pub-meta">
      {d.indexing !== 'none' && <span class={`badge ${badgeClass}`}>{indexingLabel}</span>}
      <span class="badge badge-neutral">{roleLabel}</span>
      {d.topics.map((topic) => <span class="badge badge-topic">{topicName(topic, lang)}</span>)}
    </div>
    {relatedWork.length > 0 && (
      <div class="pub-meta">
        {copy.relatedWork}:
        {relatedWork.map((slug, index) => (
          <span>
            {index > 0 && ', '}
            <a href={localeUrl(`work/${slug}`, lang)}>{workTitles[slug] ?? slug}</a>
          </span>
        ))}
      </div>
    )}
  </div>
  <div class="pub-side">
    <div class="pub-meta pub-venue">
      {d.venueShort ?? d.venue} · {d.year}
    </div>
    <div class="pub-actions">
      <a href={`https://doi.org/${d.doi}`} target="_blank" rel="noopener" aria-label={`DOI for ${d.title}`}>DOI</a>
      <BibtexButton bibtex={bibtex} />
    </div>
  </div>
</li>
