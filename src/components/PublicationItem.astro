---
import type { CollectionEntry } from 'astro:content';
import BibtexButton from './BibtexButton.astro';
import { boldSelf } from '../lib/format';
import { publicationBibtex } from '../lib/publications';
import { canonicalPostUrl } from '../lib/posts';
import { areaShort, subtopicName } from '../lib/topics';
import { langFromPath, localeUrl } from '../i18n/utils';
import { t } from '../i18n/ui';

interface Props {
  pub: CollectionEntry<'publications'>;
  workTitles?: Record<string, string>;
  notes?: CollectionEntry<'blog'>[];
}
const { pub, workTitles = {}, notes = [] } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
const copy = t(lang).publications;
const d = pub.data;
const doiHref = d.doi ? `https://doi.org/${d.doi}` : undefined;
const href = d.url ?? doiHref;
const bibtex = publicationBibtex(pub);
const badgeClass =
  d.indexing === 'Q1'
    ? 'badge-q1'
    : d.indexing === 'Q4'
      ? 'badge-q4'
      : d.indexing === 'EI'
        ? 'badge-ei'
        : 'badge-neutral';
const indexingLabel = d.indexing === 'EI' ? 'EI indexed' : `JCR ${d.indexing}`;
const roleLabel = d.role === 'first' ? copy.firstAuthor : (d.authorNote ?? copy.coAuthor);
const relatedWork = d.relatedWork ?? [];
const subtopics = d.topics.map((topic) => subtopicName(topic, lang)).join(' · ');
---
<li
  class="pub-item"
  data-role={d.role}
  data-area={d.area}
  data-year={d.year}
  data-topics={d.topics.join(' ')}
>
  <div class="pub-main">
    {href ? (
      <a class="pub-title" href={href} target="_blank" rel="noopener">{d.title}</a>
    ) : (
      <span class="pub-title">{d.title}</span>
    )}
    <div class="pub-meta"><span set:html={boldSelf(d.authors)} /></div>
    <div class="pub-meta pub-subtopics">{subtopics}</div>
    <div class="pub-meta">
      {d.indexing !== 'none' && <span class={`badge ${badgeClass}`}>{indexingLabel}</span>}
      <span class="badge badge-neutral">{roleLabel}</span>
      <span class="badge badge-topic">{areaShort(d.area, lang)}</span>
    </div>
    {relatedWork.length > 0 && (
      <div class="pub-meta">
        {copy.relatedWork}:
        {relatedWork.map((slug, index) => (
          <span>
            {index > 0 && ', '}
            <a href={localeUrl(`work/${slug}`, lang)}>{workTitles[slug] ?? slug}</a>
          </span>
        ))}
      </div>
    )}
  </div>
  <div class="pub-side">
    <div class="pub-meta pub-venue">
      {d.venueShort ?? d.venue} · {d.year}
      {d.volume && <> · vol. {d.volume}</>}
      {d.issue && <> ({d.issue})</>}
    </div>
    <div class="pub-actions">
      {doiHref && (
        <a href={doiHref} target="_blank" rel="noopener" aria-label={`DOI for ${d.title}`}>DOI</a>
      )}
      <BibtexButton bibtex={bibtex} />
      {notes.map((note) => (
        <a class="note-link" href={canonicalPostUrl(note)}>{copy.note}</a>
      ))}
    </div>
  </div>
</li>
