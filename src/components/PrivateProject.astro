---
import { existsSync } from 'node:fs';
import { langFromPath } from '../i18n/utils';
import { t } from '../i18n/ui';
import { withBase } from '../lib/url';

interface Props {
  slug: string;
}
const { slug } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
const copy = t(lang).privateProject;
const ready = existsSync(`public/private/${slug}.json`);
---
{ready ? (
  <section
    class="private-gate"
    data-private-project
    data-lang={lang}
    data-payload={withBase(`private/${slug}.json`)}
  >
    <div class="private-lock">
      <div class="private-lock-head">
        <span class="private-lock-icon" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="4" y="10" width="16" height="10" rx="2"></rect>
            <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
          </svg>
        </span>
        <div class="private-lock-copy">
          <h2>{copy.title}</h2>
          <p class="muted">{copy.intro}</p>
        </div>
      </div>
      <form class="private-form">
        <label for="private-password">{copy.label}</label>
        <div class="private-form-row">
          <div class="private-field">
            <span class="private-field-icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                width="16"
                height="16"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="7.5" cy="15.5" r="4.5"></circle>
                <path d="m11 12 9-9"></path>
                <path d="m17 6 3 3"></path>
              </svg>
            </span>
            <input
              id="private-password"
              name="password"
              type="password"
              autocomplete="current-password"
              minlength="8"
              aria-describedby="private-status"
              required
            />
            <button
              type="button"
              class="private-reveal"
              data-private-reveal
              aria-label={copy.showPassword}
              aria-pressed="false"
            >
              <span data-reveal-show>
                <svg
                  viewBox="0 0 24 24"
                  width="16"
                  height="16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M2 12s3.6-6.5 10-6.5S22 12 22 12s-3.6 6.5-10 6.5S2 12 2 12Z"></path>
                  <circle cx="12" cy="12" r="2.8"></circle>
                </svg>
              </span>
              <span data-reveal-hide hidden>
                <svg
                  viewBox="0 0 24 24"
                  width="16"
                  height="16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M9.9 4.24A11 11 0 0 1 12 4c6.4 0 10 8 10 8a18.6 18.6 0 0 1-3.1 4.3"></path>
                  <path d="M6.1 6.1A18.6 18.6 0 0 0 2 12s3.6 8 10 8a11 11 0 0 0 4-.75"></path>
                  <path d="M14.1 14.1a2.8 2.8 0 1 1-4-4"></path>
                  <path d="m2 2 20 20"></path>
                </svg>
              </span>
            </button>
          </div>
          <button type="submit" class="private-submit">{copy.unlock}</button>
        </div>
      </form>
      <p id="private-status" class="private-status" role="status" aria-live="polite"></p>
      <noscript><p class="muted">{copy.noscript}</p></noscript>
    </div>
    <div class="private-content" tabindex="-1" hidden></div>
  </section>
) : (
  <aside class="private-card">
    <h2>{copy.title}</h2>
    <p>{copy.unavailable}</p>
  </aside>
)}

<script>
  import { decryptBundle } from '../lib/private';
  import type { PrivateContent, PrivateDocument, PrivatePayload } from '../lib/private';
  import { t } from '../i18n/ui';

  const root = document.querySelector<HTMLElement>('[data-private-project]');
  if (root) {
    const lang = root.dataset.lang === 'zh' ? 'zh' : 'en';
    const copy = t(lang).privateProject;
    const labels = t(lang).projects;
    const imageTypes = new Set(['image/png', 'image/jpeg', 'image/webp', 'image/gif']);
    const payloadUrl = root.dataset.payload ?? '';
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const form = root.querySelector('form');
    const input = root.querySelector<HTMLInputElement>('input[type="password"]');
    const button = root.querySelector<HTMLButtonElement>('button[type="submit"]');
    const reveal = root.querySelector<HTMLButtonElement>('[data-private-reveal]');
    const revealShow = root.querySelector<HTMLElement>('[data-reveal-show]');
    const revealHide = root.querySelector<HTMLElement>('[data-reveal-hide]');
    const status = root.querySelector<HTMLElement>('.private-status');
    const lock = root.querySelector<HTMLElement>('.private-lock');
    const panel = root.querySelector<HTMLElement>('.private-content');
    let pending: Promise<PrivatePayload> | undefined;

    const loadPayload = () => {
      pending ??= fetch(payloadUrl, { cache: 'no-store' }).then((response) => {
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        return response.json() as Promise<PrivatePayload>;
      });
      return pending;
    };

    const heading = (text: string) => {
      const element = document.createElement('h2');
      element.textContent = text;
      return element;
    };

    const block = (label: string, text: string) => {
      const section = document.createElement('section');
      section.className = 'work-block';
      const paragraph = document.createElement('p');
      paragraph.textContent = text;
      section.append(heading(label), paragraph);
      return section;
    };

    const asideBlock = (label: string, value: string) => {
      const element = document.createElement('div');
      element.className = 'private-aside-block';
      const name = document.createElement('span');
      name.className = 'private-aside-label';
      name.textContent = label;
      const text = document.createElement('span');
      text.className = 'private-aside-value';
      text.textContent = value;
      element.append(name, text);
      return element;
    };

    const safeUrl = (value: string): string | undefined => {
      try {
        const url = new URL(value, window.location.href);
        return url.protocol === 'https:' || url.protocol === 'http:' ? url.href : undefined;
      } catch {
        return undefined;
      }
    };

    const addCopyButtons = (prose: HTMLElement) => {
      for (const pre of prose.querySelectorAll('pre')) {
        if (pre.parentElement?.classList.contains('code-block')) continue;
        const wrapper = document.createElement('div');
        wrapper.className = 'code-block';
        pre.replaceWith(wrapper);
        wrapper.append(pre);
        const trigger = document.createElement('button');
        trigger.type = 'button';
        trigger.className = 'code-copy';
        trigger.textContent = copy.copy;
        trigger.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(pre.textContent ?? '');
            trigger.textContent = copy.copied;
            setTimeout(() => (trigger.textContent = copy.copy), 1500);
          } catch {
            trigger.textContent = copy.copyFailed;
          }
        });
        wrapper.append(trigger);
      }
    };

    const decorate = (prose: HTMLElement) => {
      for (const anchor of prose.querySelectorAll<HTMLAnchorElement>('a[href]')) {
        if (anchor.getAttribute('href')?.startsWith('http')) {
          anchor.target = '_blank';
          anchor.rel = 'noopener noreferrer';
        }
      }
      for (const table of prose.querySelectorAll('table')) {
        if (table.parentElement?.classList.contains('table-scroll')) continue;
        const wrapper = document.createElement('div');
        wrapper.className = 'table-scroll';
        table.replaceWith(wrapper);
        wrapper.append(table);
      }
      addCopyButtons(prose);
    };

    const render = (content: PrivateContent) => {
      if (!panel) return;
      panel.replaceChildren();

      const documents = content.documents ?? [];
      const latest = documents
        .map((entry) => entry.date)
        .filter((date): date is string => Boolean(date))
        .sort()
        .at(-1);

      const workspace = document.createElement('div');
      workspace.className = 'private-workspace';

      const head = document.createElement('div');
      head.className = 'private-workspace-head';
      const tag = document.createElement('span');
      tag.className = 'private-workspace-tag';
      tag.textContent =
        documents.length > 0 ? `${copy.privateTag} · ${copy.count(documents.length)}` : copy.privateTag;
      head.append(tag);
      if (latest) {
        const updated = document.createElement('span');
        updated.className = 'private-workspace-updated';
        updated.textContent = `${copy.lastUpdated} ${latest}`;
        head.append(updated);
      }

      const main = document.createElement('div');
      main.className = 'private-main';

      const home = document.createElement('div');
      home.className = 'private-home';

      if (content.summary) {
        const lede = document.createElement('p');
        lede.className = 'lede';
        lede.textContent = content.summary;
        home.append(lede);
      }

      const fields: [string, string | undefined][] = [
        [labels.goal, content.goal],
        [labels.architecture, content.architecture],
        [labels.role, content.role],
        [labels.results, content.results],
      ];
      for (const [label, text] of fields) {
        if (text) home.append(block(label, text));
      }

      for (const image of content.images ?? []) {
        if (!image.alt || !image.data || !imageTypes.has(image.type)) continue;
        const figure = document.createElement('figure');
        const element = document.createElement('img');
        element.src = `data:${image.type};base64,${image.data}`;
        element.alt = image.alt;
        element.loading = 'lazy';
        const caption = document.createElement('figcaption');
        caption.textContent = image.alt;
        figure.append(element, caption);
        home.append(figure);
      }

      if (content.links && content.links.length > 0) {
        const links = content.links
          .map((link) => ({ label: link.label, href: safeUrl(link.url) }))
          .filter((link): link is { label: string; href: string } => Boolean(link.href));
        if (links.length > 0) {
          const section = document.createElement('section');
          section.className = 'work-block';
          const list = document.createElement('div');
          list.className = 'links';
          for (const link of links) {
            const anchor = document.createElement('a');
            anchor.href = link.href;
            anchor.target = '_blank';
            anchor.rel = 'noopener noreferrer';
            anchor.textContent = link.label;
            list.append(anchor);
          }
          section.append(heading(labels.links), list);
          home.append(section);
        }
      }

      const reader = document.createElement('section');
      reader.className = 'private-reader';
      reader.hidden = true;

      const openDocument = (entry: PrivateDocument, trigger: HTMLButtonElement) => {
        reader.replaceChildren();

        const bar = document.createElement('div');
        bar.className = 'private-reader-bar';
        const back = document.createElement('button');
        back.type = 'button';
        back.className = 'private-back';
        back.textContent = copy.backToList;
        back.addEventListener('click', () => {
          reader.hidden = true;
          reader.replaceChildren();
          home.hidden = false;
          workspace.classList.remove('is-reading');
          trigger.focus();
        });
        const current = document.createElement('span');
        current.className = 'private-reader-title';
        current.textContent = entry.title;
        bar.append(back, current);

        const prose = document.createElement('div');
        prose.className = 'prose private-doc';
        // Built at encryption time and authenticated by AES-GCM, so it cannot be
        // altered without the password.
        prose.innerHTML = entry.html;
        decorate(prose);

        reader.append(bar, prose);
        home.hidden = true;
        reader.hidden = false;
        workspace.classList.add('is-reading');
        reader.scrollIntoView({
          behavior: reduceMotion ? 'auto' : 'smooth',
          block: 'start',
        });
      };

      if (documents.length > 0) {
        const section = document.createElement('section');
        section.className = 'private-docs';
        section.append(heading(copy.documents));
        const list = document.createElement('ul');
        list.className = 'private-doc-list';
        documents.forEach((entry, index) => {
          const item = document.createElement('li');
          const trigger = document.createElement('button');
          trigger.type = 'button';
          trigger.className = 'private-doc-item';

          const number = document.createElement('span');
          number.className = 'private-doc-index';
          number.textContent = String(index + 1).padStart(2, '0');

          const body = document.createElement('span');
          body.className = 'private-doc-body';
          const title = document.createElement('span');
          title.className = 'private-doc-title';
          title.textContent = entry.title;
          body.append(title);
          const meta = [entry.date, entry.summary].filter(Boolean).join(' · ');
          if (meta) {
            const details = document.createElement('span');
            details.className = 'private-doc-meta';
            details.textContent = meta;
            body.append(details);
          }

          const arrow = document.createElement('span');
          arrow.className = 'private-doc-arrow';
          arrow.setAttribute('aria-hidden', 'true');

          trigger.append(number, body, arrow);
          trigger.addEventListener('click', () => openDocument(entry, trigger));
          item.append(trigger);
          list.append(item);
        });
        section.append(list);
        home.append(section);
      } else if (content.documents) {
        const empty = document.createElement('p');
        empty.className = 'muted private-empty';
        empty.textContent = copy.noDocuments;
        home.append(empty);
      } else if (content.body) {
        const prose = document.createElement('div');
        prose.className = 'prose';
        for (const paragraph of content.body.split(/\n\s*\n/)) {
          if (!paragraph.trim()) continue;
          const element = document.createElement('p');
          element.textContent = paragraph.trim();
          prose.append(element);
        }
        home.append(prose);
      }

      main.append(home, reader);

      const aside = document.createElement('aside');
      aside.className = 'private-aside';
      aside.append(heading(copy.projectInfo));
      if (content.stack && content.stack.length > 0) {
        const stackBlock = document.createElement('div');
        stackBlock.className = 'private-aside-block';
        const stackLabel = document.createElement('span');
        stackLabel.className = 'private-aside-label';
        stackLabel.textContent = labels.stack;
        const stack = document.createElement('div');
        stack.className = 'stack';
        for (const tech of content.stack) {
          const chip = document.createElement('span');
          chip.textContent = tech;
          stack.append(chip);
        }
        stackBlock.append(stackLabel, stack);
        aside.append(stackBlock);
      }
      aside.append(asideBlock(copy.access, copy.accessValue));

      workspace.append(head, main, aside);
      panel.append(workspace);
    };

    reveal?.addEventListener('click', () => {
      if (!input) return;
      const showing = input.type === 'text';
      input.type = showing ? 'password' : 'text';
      reveal.setAttribute('aria-pressed', String(!showing));
      reveal.setAttribute('aria-label', showing ? copy.showPassword : copy.hidePassword);
      revealShow?.toggleAttribute('hidden', !showing);
      revealHide?.toggleAttribute('hidden', showing);
      input.focus();
    });

    input?.addEventListener('input', () => {
      input.removeAttribute('aria-invalid');
      if (status?.dataset.state === 'error') {
        status.textContent = '';
        delete status.dataset.state;
      }
    });

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!input || !status || !panel || button?.disabled) return;
      const password = input.value;
      if (!password) return;

      status.dataset.state = 'loading';
      status.textContent = copy.loading;
      if (button) button.disabled = true;
      input.readOnly = true;

      let payload: PrivatePayload;
      try {
        payload = await loadPayload();
      } catch {
        status.dataset.state = 'error';
        status.textContent = copy.unavailable;
        if (button) button.disabled = false;
        input.readOnly = false;
        return;
      }

      try {
        const bundle = await decryptBundle(payload, password);
        const content = bundle[lang] ?? bundle.en ?? bundle.zh;
        if (!content) throw new Error('empty bundle');
        render(content);
        root.classList.add('is-open');
        panel.hidden = false;
        panel.classList.remove('is-revealed');
        void panel.offsetWidth;
        panel.classList.add('is-revealed');
        lock?.setAttribute('hidden', '');
        status.textContent = '';
        delete status.dataset.state;
        input.removeAttribute('aria-invalid');
        panel.focus();
      } catch {
        status.dataset.state = 'error';
        status.textContent = copy.error;
        input.setAttribute('aria-invalid', 'true');
        input.select();
      } finally {
        if (button) button.disabled = false;
        input.readOnly = false;
      }
    });
  }
</script>
