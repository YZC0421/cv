---
import ThemeToggle from './ThemeToggle.astro';
import NavLinks from './NavLinks.astro';
import { site } from '../lib/site';
import { stripBase, withBase } from '../lib/url';

interface Props {
  langLink?: { href: string; label: string; lang: string };
}
const { langLink } = Astro.props;

const links = [
  { path: 'projects', label: 'Projects' },
  { path: 'blog', label: 'Writing' },
  { path: 'publications', label: 'Research' },
  { path: 'resume', label: 'Resume' },
  { path: 'about', label: 'About' },
  { path: 'contact', label: 'Contact' },
];
const current = stripBase(Astro.url.pathname);
const isHome = current === '/';
---
<header class="site-header">
  <div class="inner">
    <a class="brand" href={withBase()} aria-current={isHome ? 'page' : undefined}>{site.name}</a>
    <nav class="nav desktop-nav" aria-label="Primary">
      <NavLinks links={links} current={current} />
    </nav>
    <details class="nav-details">
      <summary class="nav-toggle">Menu</summary>
      <nav class="nav" aria-label="Primary mobile">
        <NavLinks links={links} current={current} />
      </nav>
    </details>
    {langLink && (
      <a class="lang-link" href={langLink.href} hreflang={langLink.lang} lang={langLink.lang}>
        {langLink.label}
      </a>
    )}
    <ThemeToggle />
  </div>
</header>
<script is:inline>
  (() => {
    const details = document.querySelector('.nav-details');
    if (!details) return;
    document.addEventListener('click', (event) => {
      if (details.open && !details.contains(event.target)) details.open = false;
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') details.open = false;
    });
  })();
</script>
