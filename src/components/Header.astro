---
import ThemeToggle from './ThemeToggle.astro';
import NavLinks from './NavLinks.astro';
import { site } from '../lib/site';
import { t } from '../i18n/ui';
import { alternateUrl, contentPath, langFromPath, localeUrl } from '../i18n/utils';

interface Props {
  hideLangSwitch?: boolean;
  /** `null` means the translation does not exist; show a note instead of a dead link. */
  langSwitchHref?: string | null;
}
const { hideLangSwitch = false, langSwitchHref } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
const copy = t(lang);
const path = contentPath(Astro.url.pathname);

const items = [
  { path: 'projects', label: copy.nav.projects },
  { path: 'blog', label: copy.nav.writing },
  { path: 'publications', label: copy.nav.research },
  { path: 'resume', label: copy.nav.resume },
  { path: 'about', label: copy.nav.about },
  { path: 'contact', label: copy.nav.contact },
];

const links = items.map((item) => ({
  href: localeUrl(item.path, lang),
  label: item.label,
  current: path === `/${item.path}/` || path.startsWith(`/${item.path}/`),
}));

const otherLang = lang === 'zh' ? 'en' : 'zh';
const switchHref =
  langSwitchHref === undefined ? alternateUrl(Astro.url.pathname, otherLang) : langSwitchHref;
const switchLabel = copy.common.switchTo;
const langNote = lang === 'zh' ? '暂无英文版' : 'No Chinese version';
const isHome = path === '/';
---
<header class="site-header">
  <div class="inner">
    <a class="brand" href={localeUrl('', lang)} aria-current={isHome ? 'page' : undefined}>{site.name}</a>
    <nav class="nav desktop-nav" aria-label="Primary">
      <NavLinks links={links} />
    </nav>
    <details class="nav-details">
      <summary class="nav-toggle">{copy.nav.menu}</summary>
      <nav class="nav" aria-label="Primary mobile">
        <NavLinks links={links} />
      </nav>
    </details>
    {!hideLangSwitch &&
      (switchHref ? (
        <a
          class="lang-link"
          href={switchHref}
          hreflang={otherLang === 'zh' ? 'zh-CN' : 'en'}
          lang={otherLang === 'zh' ? 'zh-CN' : 'en'}
          aria-label={copy.common.switchLabel}
        >
          {switchLabel}
        </a>
      ) : (
        <span class="lang-note" lang={otherLang === 'zh' ? 'zh-CN' : 'en'}>
          {langNote}
        </span>
      ))}
    <ThemeToggle />
  </div>
</header>
<script is:inline>
  (() => {
    const details = document.querySelector('.nav-details');
    if (!details) return;
    document.addEventListener('click', (event) => {
      if (details.open && !details.contains(event.target)) details.open = false;
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') details.open = false;
    });
  })();
</script>
