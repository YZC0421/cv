---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import WorkCard from '../../../components/WorkCard.astro';
import { getCollection } from 'astro:content';
import { subtopicName, subtopicSlugs } from '../../../lib/topics';
import { localeUrl } from '../../../i18n/utils';
import { t } from '../../../i18n/ui';
import { sortExperience, sortProjects } from '../../../lib/work';

const copy = t('zh').work;
const all = await getCollection('work');
const experience = sortExperience(all.filter((item) => item.data.kind === 'experience'));
const projects = sortProjects(all.filter((item) => item.data.kind === 'project'));
const projectTopics = subtopicSlugs.filter((slug) =>
  projects.some((item) => (item.data.topics ?? []).includes(slug))
);
---
<BaseLayout title="工作与项目 · 杨梓聪" description="工程经历与研究项目。" lang="zh">
  <div class="container" style="padding-top:40px">
    <h1>{copy.title}</h1>

    <section class="section">
      <div class="section-head"><h2>{copy.experience}</h2></div>
      <ul class="timeline">
        {experience.map((job) => (
          <li>
            <h3><a href={localeUrl(`work/${job.id}`, 'zh')}>{job.data.title}</a></h3>
            <div class="org">{job.data.org}</div>
            <div class="when">{job.data.start} – {job.data.end}</div>
            <ul>{job.data.highlights.slice(0, 3).map((highlight) => <li>{highlight}</li>)}</ul>
          </li>
        ))}
      </ul>
    </section>

    <section class="section">
      <div class="section-head"><h2>{copy.projects}</h2></div>
      {projectTopics.length > 0 && (
        <div class="filters" role="group" aria-label="按主题筛选项目">
          <span class="filter-label">主题</span>
          <button type="button" data-value="all" aria-pressed="true">{copy.all}</button>
          {projectTopics.map((topic) => (
            <button type="button" data-value={topic} aria-pressed="false">
              {subtopicName(topic, 'zh')}
            </button>
          ))}
        </div>
      )}
      <div class="work-grid">{projects.map((item) => <WorkCard item={item} />)}</div>
      <p id="work-status" class="muted" role="status" aria-live="polite"></p>
    </section>
  </div>

  <script is:inline define:vars={{ emptyText: copy.empty, template: '显示 {v} / {t} 个项目。' }}>
    (() => {
      const buttons = document.querySelectorAll('.filters button');
      const cards = document.querySelectorAll('.work-card');
      const status = document.getElementById('work-status');
      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const value = btn.dataset.value;
          buttons.forEach((other) => other.setAttribute('aria-pressed', String(other === btn)));
          let visible = 0;
          cards.forEach((card) => {
            const cardTopics = (card.dataset.topics ?? '').split(' ').filter(Boolean);
            card.hidden = value !== 'all' && !cardTopics.includes(value);
            if (!card.hidden) visible += 1;
          });
          if (status) {
            status.textContent =
              visible === 0
                ? emptyText
                : template.replace('{v}', visible).replace('{t}', cards.length);
          }
        });
      });
    })();
  </script>
</BaseLayout>
