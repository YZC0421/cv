---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PostList from '../../../../components/PostList.astro';
import { getCollection } from 'astro:content';
import { postTags, visiblePosts } from '../../../../lib/posts';
import { localeUrl } from '../../../../i18n/utils';

export async function getStaticPaths() {
  const posts = visiblePosts(await getCollection('blog'));
  return postTags(posts).map((tag) => ({
    params: { tag },
    props: { tag, posts: posts.filter((post) => post.data.tags.includes(tag)) },
  }));
}

interface Props {
  tag: string;
  posts: CollectionEntry<'blog'>[];
}
const { tag, posts } = Astro.props;
---
<BaseLayout title={`#${tag} · 博客`} description={`标签 ${tag} 下的文章。`} lang="zh">
  <div class="container" style="padding-top:48px">
    <h1>#{tag}</h1>
    <p class="muted"><a href={localeUrl('blog', 'zh')}>← 全部文章</a></p>
    <PostList posts={posts} />
  </div>
</BaseLayout>
