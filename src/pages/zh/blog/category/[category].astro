---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PostList from '../../../../components/PostList.astro';
import { getCollection } from 'astro:content';
import { categoryLabel } from '../../../../lib/blog';
import { visiblePosts } from '../../../../lib/posts';
import { localeUrl } from '../../../../i18n/utils';

export async function getStaticPaths() {
  const posts = visiblePosts(await getCollection('blog'));
  const categories = [...new Set(posts.map((post) => post.data.category))];
  return categories.map((category) => ({
    params: { category },
    props: {
      category,
      posts: posts.filter((post) => post.data.category === category),
    },
  }));
}

interface Props {
  category: string;
  posts: CollectionEntry<'blog'>[];
}
const { category, posts } = Astro.props;
---
<BaseLayout title={`${categoryLabel(category, 'zh')} · 博客`} description={`${categoryLabel(category, 'zh')} 分类下的文章。`} lang="zh">
  <div class="container" style="padding-top:48px">
    <p class="eyebrow"><a href={localeUrl('blog', 'zh')}>博客</a> / 分类</p>
    <h1>{categoryLabel(category, 'zh')}</h1>
    <p class="muted">{posts.length} 篇文章</p>
    <PostList posts={posts} />
  </div>
</BaseLayout>
