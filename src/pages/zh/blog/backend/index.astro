---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { backendSections } from '../../../../lib/backend';
import { withBase } from '../../../../lib/url';

const notes = (await getCollection('backend')).filter((note) => !note.data.draft);
const counts = new Map<string, number>();
for (const note of notes) {
  counts.set(note.data.section, (counts.get(note.data.section) ?? 0) + 1);
}
---
<BaseLayout
  title="后端笔记 · 杨梓聪"
  description="按 16 个板块整理的后端学习笔记：从计算机基础、网络、数据库到分布式与可观测性。"
  lang="zh-CN"
  langSwitchHref={null}
  alternates={[{ lang: 'zh', href: new URL(Astro.url.pathname, Astro.site).href }]}
>
  <div class="container" style="padding-top:48px">
    <p class="eyebrow"><a href={withBase('zh/blog')}>博客</a> / 后端笔记</p>
    <h1>后端笔记</h1>
    <p class="muted">按 16 个板块整理的后端学习笔记，共 {notes.length} 篇。</p>

    <ul class="backend-sections">
      {backendSections.map((section) => {
        const count = counts.get(section.slug) ?? 0;
        return (
          <li>
            <a class="backend-section-item" href={withBase(`zh/blog/backend/${section.slug}`)}>
              <span class="backend-section-index">{section.index}</span>
              <span class="backend-section-title">{section.title}</span>
              <span class="backend-section-count">{count > 0 ? `${count} 篇` : '待补充'}</span>
              <span class="backend-section-arrow" aria-hidden="true"></span>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</BaseLayout>
