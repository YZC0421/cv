---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TagFilter from '../../../components/TagFilter.astro';
import { getCollection } from 'astro:content';
import { categoryLabel } from '../../../lib/blog';
import { backendSections, findBackendSection } from '../../../lib/backend';
import { postTags, postsByLang, visiblePosts } from '../../../lib/posts';
import { localeUrl } from '../../../i18n/utils';
import { withBase } from '../../../lib/url';
import { t } from '../../../i18n/ui';

const copy = t('zh').blog;
const posts = postsByLang(visiblePosts(await getCollection('blog')), 'zh');
const tags = postTags(posts);

const backendNotes = (await getCollection('backend')).filter((note) => !note.data.draft);
const counts = new Map<string, number>();
for (const note of backendNotes) {
  counts.set(note.data.section, (counts.get(note.data.section) ?? 0) + 1);
}
const latestNote = [...backendNotes].sort((a, b) => b.data.date.localeCompare(a.data.date))[0];
const latestSection = latestNote ? findBackendSection(latestNote.data.section) : undefined;
const latestHref =
  latestNote && latestSection
    ? withBase(`zh/blog/backend/${latestSection.slug}/${latestNote.id.split('/').at(-1)}`)
    : undefined;
---
<BaseLayout title="博客 · 杨梓聪" description="后端学习笔记与技术文章。" lang="zh">
  <div class="container blog-index">
    <header class="blog-head">
      <h1>{copy.title}</h1>
      <p class="muted">
        {
          posts.length > 0
            ? `${copy.intro} 共 ${posts.length} 篇。`
            : `按 ${backendSections.length} 个板块整理的后端学习笔记，共 ${backendNotes.length} 篇。`
        }
      </p>
    </header>

    <div class="blog-layout">
      <div class="blog-main">
        {posts.length > 0 && (
          <section class="blog-posts-section">
            <div class="blog-section-head">
              <h2>文章</h2>
              <span class="muted">共 {posts.length} 篇</span>
            </div>
            <TagFilter tags={tags} allLabel="全部" />
            <ul class="post-list blog-posts" id="post-list">
              {posts.map((post) => (
                <li class="blog-post" data-tags={post.data.tags.join('|')}>
                  <time datetime={post.data.date}>{post.data.date}</time>
                  <div class="blog-post-main">
                    <a class="blog-post-title" href={localeUrl(`blog/${post.id}`, 'zh')}>
                      {post.data.title}
                    </a>
                    <p class="blog-post-summary">{post.data.summary}</p>
                    <div class="blog-post-tags">
                      <a
                        class="category-badge"
                        href={localeUrl(`blog/category/${post.data.category}`, 'zh')}
                      >
                        {categoryLabel(post.data.category, 'zh')}
                      </a>
                      <span class="lang-badge">{post.data.lang === 'zh' ? '中文' : 'EN'}</span>
                      {post.data.tags.map((tag) => (
                        <a
                          class="tag-badge"
                          href={localeUrl(`blog/tag/${encodeURIComponent(tag)}`, 'zh')}
                        >
                          {tag}
                        </a>
                      ))}
                    </div>
                  </div>
                </li>
              ))}
            </ul>
            <p id="blog-status" class="muted blog-status" role="status" aria-live="polite"></p>
          </section>
        )}

        <details class="backend-disclosure" id="backend-notes">
          <summary class="backend-disclosure-summary">
            <span class="backend-disclosure-title">后端笔记</span>
            <span class="backend-disclosure-count">
              {backendSections.length} 个板块 · {backendNotes.length} 篇
            </span>
            <span class="backend-disclosure-toggle" aria-hidden="true"></span>
          </summary>
          <ul class="backend-sections">
            {backendSections.map((section) => {
              const count = counts.get(section.slug) ?? 0;
              return (
                <li>
                  <a class="backend-section-item" href={withBase(`zh/blog/backend/${section.slug}`)}>
                    <span class="backend-section-index">{section.index}</span>
                    <span class="backend-section-title">{section.title}</span>
                    <span class="backend-section-count">{count > 0 ? `${count} 篇` : '待补充'}</span>
                    <span class="backend-section-arrow" aria-hidden="true"></span>
                  </a>
                </li>
              );
            })}
          </ul>
        </details>
      </div>

      <aside class="blog-side">
        {latestNote && latestSection && latestHref && (
          <section class="blog-side-card">
            <p class="blog-side-eyebrow">最新笔记</p>
            <h2>{latestNote.data.title}</h2>
            <p class="muted">
              {latestSection.index} · {latestSection.title} · {latestNote.data.date}
            </p>
            <div class="blog-side-actions">
              <a href={latestHref}>阅读笔记 →</a>
              <a href="#backend-notes" data-open-notes>全部 {backendSections.length} 个板块 →</a>
            </div>
          </section>
        )}
        <div class="blog-side-links">
          <a href={localeUrl('search', 'zh')}>{copy.search}</a>
          <a href={localeUrl('rss.xml', 'zh')}>{copy.rss}</a>
        </div>
      </aside>
    </div>
  </div>

  <script
    is:inline
    define:vars={{ emptyText: '没有符合该标签的文章。', template: '显示 {v} / {t} 篇文章。' }}
  >
    (() => {
      const buttons = document.querySelectorAll('.filters button');
      const rows = [...document.querySelectorAll('#post-list li')];
      const status = document.getElementById('blog-status');
      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          buttons.forEach((other) => other.setAttribute('aria-pressed', String(other === btn)));
          const tag = btn.dataset.tag;
          let visible = 0;
          rows.forEach((row) => {
            row.hidden = tag !== 'all' && !(row.dataset.tags ?? '').split('|').includes(tag);
            if (!row.hidden) visible += 1;
          });
          if (status) {
            status.textContent =
              visible === 0
                ? emptyText
                : template.replace('{v}', visible).replace('{t}', rows.length);
          }
        });
      });
    })();
  </script>

  <script is:inline>
    (() => {
      const details = document.getElementById('backend-notes');
      if (!(details instanceof HTMLDetailsElement)) return;
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      document.querySelectorAll('[data-open-notes]').forEach((link) => {
        link.addEventListener('click', (event) => {
          event.preventDefault();
          details.open = true;
          details.scrollIntoView({
            behavior: reduceMotion ? 'auto' : 'smooth',
            block: 'start',
          });
          history.replaceState(null, '', '#backend-notes');
        });
      });
      if (location.hash === '#backend-notes') details.open = true;
    })();
  </script>
</BaseLayout>
