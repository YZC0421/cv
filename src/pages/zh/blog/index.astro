---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TagFilter from '../../../components/TagFilter.astro';
import { getCollection } from 'astro:content';
import { categoryLabel } from '../../../lib/blog';
import { postTags, postsByLang, visiblePosts } from '../../../lib/posts';
import { localeUrl } from '../../../i18n/utils';
import { t } from '../../../i18n/ui';

const copy = t('zh').blog;
const posts = postsByLang(visiblePosts(await getCollection('blog')), 'zh');
const tags = postTags(posts);
---
<BaseLayout title="博客 · 杨梓聪" description="关于 AI、软件工程与研究的技术笔记。" lang="zh">
  <div class="container" style="padding-top:48px">
    <h1>{copy.title}</h1>
    <p class="muted">
      {copy.intro} 共 {posts.length} 篇。
      <a href={localeUrl('search', 'zh')}>{copy.search}</a> ·
      <a href={localeUrl('rss.xml', 'zh')}>{copy.rss}</a>
    </p>

    <TagFilter tags={tags} allLabel="全部" />
    <ul class="post-list" id="post-list">
      {posts.map((post) => (
        <li data-tags={post.data.tags.join('|')}>
          <time datetime={post.data.date}>{post.data.date}</time>
          <a href={localeUrl(`blog/${post.id}`, 'zh')}>{post.data.title}</a>
          <a class="category-badge" href={localeUrl(`blog/category/${post.data.category}`, 'zh')}>
            {categoryLabel(post.data.category, 'zh')}
          </a>
          <span class="lang-badge">{post.data.lang === 'zh' ? '中文' : 'EN'}</span>
          {post.data.tags.map((tag) => (
            <a class="tag-badge" href={localeUrl(`blog/tag/${encodeURIComponent(tag)}`, 'zh')}>{tag}</a>
          ))}
        </li>
      ))}
    </ul>
  </div>

  <script is:inline>
    (() => {
      const buttons = document.querySelectorAll('.filters button');
      const rows = document.querySelectorAll('#post-list li');
      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
          const tag = btn.dataset.tag;
          rows.forEach((row) => {
            row.hidden = tag !== 'all' && !(row.dataset.tags ?? '').split('|').includes(tag);
          });
        });
      });
    })();
  </script>
</BaseLayout>
