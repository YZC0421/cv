---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localeUrl } from '../../i18n/utils';
import { t } from '../../i18n/ui';

const copy = t('zh').search;
---
<BaseLayout title="搜索 · 杨梓聪" description="搜索文章、项目与页面。" lang="zh">
  <Fragment slot="head">
    <link rel="stylesheet" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/pagefind/pagefind-ui.css`} />
    <script is:inline src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/pagefind/pagefind-ui.js`}></script>
  </Fragment>
  <div class="container medium" style="padding-top:48px">
    <h1>{copy.title}</h1>
    <p class="muted">{copy.intro}</p>
    <div id="search"></div>
    <noscript>
      <p class="muted">
        {copy.noscript}
      </p>
    </noscript>
  </div>
  <script is:inline define:vars={{ bundlePath: `${import.meta.env.BASE_URL.replace(/\/$/, '')}/pagefind/` }}>
    window.addEventListener('DOMContentLoaded', () => {
      if (window.PagefindUI) {
        new window.PagefindUI({ element: '#search', showSubResults: true, bundlePath });
      }
    });
  </script>
</BaseLayout>
