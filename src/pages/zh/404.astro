---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localeUrl } from '../../i18n/utils';
import { t } from '../../i18n/ui';

const copy = t('zh').common;
---
<BaseLayout title="页面不存在 · 杨梓聪" description="页面不存在。" lang="zh" noindex>
  <div class="container medium" style="padding:80px 24px">
    <h1>404</h1>
    <p class="muted">{copy.notFoundText}</p>
    <p><a href={localeUrl('', 'zh')}>{copy.backHome} <span aria-hidden="true">→</span></a></p>
  </div>
</BaseLayout>
