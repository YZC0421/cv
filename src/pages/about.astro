---
import PageLayout from '../layouts/PageLayout.astro';
import { getEntry, render } from 'astro:content';
import { withBase } from '../lib/url';

const entry = await getEntry('pages', 'about-en');
if (!entry) throw new Error('about-en.md is missing');
const { Content } = await render(entry);
const enHref = new URL(withBase('about'), Astro.site);
const zhHref = new URL(withBase('about/zh'), Astro.site);
---
<PageLayout
  title="About · Zicong Yang"
  description="Education, research, skills, and contact."
  langLink={{ href: withBase('about/zh'), label: '中文', lang: 'zh-CN' }}
  heading={entry.data.title}
  updated={entry.data.updated}
  updatedLabel="Updated"
  printLabel="Download CV (PDF)"
  enHref={enHref}
  zhHref={zhHref}
>
  <Content />
</PageLayout>
