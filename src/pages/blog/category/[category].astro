---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostList from '../../../components/PostList.astro';
import { getCollection } from 'astro:content';
import { categoryLabel } from '../../../lib/blog';
import { sortPaperReading } from '../../../lib/publications';
import { postsByLang, visiblePosts } from '../../../lib/posts';
import { localeUrl } from '../../../i18n/utils';
import { withBase } from '../../../lib/url';

export async function getStaticPaths() {
  const all = visiblePosts(await getCollection('blog'));
  const posts = postsByLang(all, 'en');
  const publications = await getCollection('publications');
  const zhCategories = new Set(postsByLang(all, 'zh').map((post) => post.data.category));
  const categories = [...new Set(posts.map((post) => post.data.category))];
  return categories.map((category) => {
    const filtered = posts.filter((post) => post.data.category === category);
    return {
      params: { category },
      props: {
        category,
        posts: category === 'paper-reading' ? sortPaperReading(filtered, publications) : filtered,
        hasZh: zhCategories.has(category),
      },
    };
  });
}

interface Props {
  category: string;
  posts: CollectionEntry<'blog'>[];
  hasZh: boolean;
}
const { category, posts, hasZh } = Astro.props;
const categoryPath = `blog/category/${encodeURIComponent(category)}`;
---
<BaseLayout
  title={`${categoryLabel(category)} · Writing`}
  description={`Posts in ${categoryLabel(category)}.`}
  langSwitchHref={hasZh ? localeUrl(categoryPath, 'zh') : null}
>
  <div class="container" style="padding-top:48px">
    <p class="eyebrow"><a href={withBase('blog')}>Writing</a> / Category</p>
    <h1>{categoryLabel(category)}</h1>
    <p class="muted">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</p>
    <PostList posts={posts} />
  </div>
</BaseLayout>
