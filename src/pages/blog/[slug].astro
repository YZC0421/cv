---
import type { CollectionEntry } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { getCollection, render } from 'astro:content';
import { localToday } from '../../lib/date';
import { readingMinutes } from '../../lib/format';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const today = localToday();
  const posts = await getCollection('blog', ({ data }) => !data.draft && data.date <= today);
  const sorted = posts.sort((a, b) => b.data.date.localeCompare(a.data.date));
  return sorted.map((post, index) => ({
    params: { slug: post.id },
    props: { post, prev: sorted[index + 1], next: sorted[index - 1] },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
  prev?: CollectionEntry<'blog'>;
  next?: CollectionEntry<'blog'>;
}
const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);
const readingTime = readingMinutes(post.body ?? '');
---
<PostLayout
  title={post.data.title}
  description={post.data.summary}
  date={post.data.date}
  lang={post.data.lang}
  tags={post.data.tags}
  headings={headings}
  readingTime={readingTime}
>
  <Content />
  <div class="next-prev" slot="footer">
    <span>{prev ? <a href={withBase(`blog/${prev.id}`)}>← {prev.data.title}</a> : null}</span>
    <span>{next ? <a href={withBase(`blog/${next.id}`)}>{next.data.title} →</a> : null}</span>
  </div>
</PostLayout>
