---
import type { CollectionEntry } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { getCollection, render } from 'astro:content';
import { readingMinutes } from '../../lib/format';
import { visiblePosts } from '../../lib/posts';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const posts = visiblePosts(await getCollection('blog'));
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: { post, prev: posts[index + 1], next: posts[index - 1] },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
  prev?: CollectionEntry<'blog'>;
  next?: CollectionEntry<'blog'>;
}
const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);
const readingTime = readingMinutes(post.body ?? '');
---
<PostLayout
  title={post.data.title}
  description={post.data.summary}
  date={post.data.date}
  lang={post.data.lang}
  tags={post.data.tags}
  headings={headings}
  readingTime={readingTime}
>
  <Content />
  {(prev || next) && (
    <div class="next-prev" slot="footer">
      <span>{prev ? <a href={withBase(`blog/${prev.id}`)}>← {prev.data.title}</a> : null}</span>
      <span>{next ? <a href={withBase(`blog/${next.id}`)}>{next.data.title} →</a> : null}</span>
    </div>
  )}
</PostLayout>
