---
import type { CollectionEntry } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import BibtexButton from '../../components/BibtexButton.astro';
import { getCollection, render } from 'astro:content';
import { relatedPosts } from '../../lib/blog';
import { readingMinutes, wordCount } from '../../lib/format';
import { hasMermaid } from '../../lib/markdown';
import { findPublication, publicationBibtex } from '../../lib/publications';
import { t } from '../../i18n/ui';
import {
  canonicalPostPath,
  canonicalPostUrl,
  isCanonicalPath,
  isStale,
  lastReviewed,
  translationFor,
  visiblePosts,
} from '../../lib/posts';

export async function getStaticPaths() {
  const posts = visiblePosts(await getCollection('blog'));
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      prev: posts[index + 1],
      next: posts[index - 1],
      related: relatedPosts(posts, post),
    },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
  prev?: CollectionEntry<'blog'>;
  next?: CollectionEntry<'blog'>;
  related: CollectionEntry<'blog'>[];
}
const { post, prev, next, related } = Astro.props;
const { Content, headings } = await render(post);
const readingTime = readingMinutes(post.body ?? '');
const allPosts = visiblePosts(await getCollection('blog'));
const counterpart = translationFor(allPosts, post);
const canonical = canonicalPostUrl(post);
const alternates: { lang: 'en' | 'zh'; href: string }[] = [
  { lang: post.data.lang, href: new URL(canonical, Astro.site).href },
  ...(counterpart
    ? [
        {
          lang: counterpart.data.lang,
          href: new URL(canonicalPostUrl(counterpart), Astro.site).href,
        },
      ]
    : []),
];
const noindex = !isCanonicalPath(post, Astro.url.pathname);
const langSwitchHref = counterpart
  ? new URL(canonicalPostUrl(counterpart), Astro.site).pathname
  : null;
const copy = t(post.data.lang).blog;
const staleSince = !post.data.draft && isStale(post) ? lastReviewed(post) : undefined;
const paperRef = post.data.paper
  ? findPublication(await getCollection('publications'), post.data.paper)
  : undefined;
---
<PostLayout
  title={post.data.title}
  description={post.data.summary}
  date={post.data.date}
  lang={post.data.lang}
  tags={post.data.tags}
  headings={headings}
  readingTime={readingTime}
  cover={post.data.cover}
  draft={post.data.draft}
  noindex={noindex}
  alternates={alternates}
  langSwitchHref={langSwitchHref}
  canonicalPath={canonicalPostPath(post)}
  hasMermaid={hasMermaid(post.body ?? '')}
  updated={post.data.updated}
  changelog={post.data.changelog}
  staleSince={staleSince}
  ogImagePath={`og/${post.id}.png`}
  category={post.data.category}
  words={wordCount(post.body ?? '')}
>
  <Content />

  {paperRef && (
    <aside class="paper-ref">
      <p class="paper-ref-label">{copy.paperNote}</p>
      <p class="paper-ref-title">
        {paperRef.data.url || paperRef.data.doi ? (
          <a
            href={paperRef.data.url ?? `https://doi.org/${paperRef.data.doi}`}
            target="_blank"
            rel="noopener"
          >
            {paperRef.data.title}
          </a>
        ) : (
          paperRef.data.title
        )}
      </p>
      <p class="muted">{paperRef.data.venueShort ?? paperRef.data.venue} · {paperRef.data.year}</p>
      <BibtexButton bibtex={publicationBibtex(paperRef)} />
    </aside>
  )}

  {related.length > 0 && (
    <aside class="related">
      <h2>Related posts</h2>
      <ul>
        {related.map((item) => (
          <li><a href={canonicalPostUrl(item)}>{item.data.title}</a></li>
        ))}
      </ul>
    </aside>
  )}

  {(prev || next) && (
    <div class="next-prev" slot="footer">
      <span>{prev ? <a href={canonicalPostUrl(prev)}>← {prev.data.title}</a> : null}</span>
      <span>{next ? <a href={canonicalPostUrl(next)}>{next.data.title} →</a> : null}</span>
    </div>
  )}
</PostLayout>
