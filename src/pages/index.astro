---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ResearchAreas from '../components/ResearchAreas.astro';
import PublicationItem from '../components/PublicationItem.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostList from '../components/PostList.astro';
import { getCollection } from 'astro:content';
import { profile } from '../data/profile';
import { notesByPublication, selectHomepage } from '../lib/publications';
import { postsByLang, visiblePosts } from '../lib/posts';
import { validateBlogPapers, validateRelations } from '../lib/relations';
import { featuredProjects } from '../lib/projects';
import { withBase } from '../lib/url';
import { workTitleMap } from '../lib/work';

const allPublications = await getCollection('publications');
const allWork = await getCollection('work');
const relationErrors = validateRelations(allPublications, allWork);
if (relationErrors.length > 0) {
  throw new Error(`Content relations are invalid:\n${relationErrors.join('\n')}`);
}

const allPosts = await getCollection('blog');
const blogErrors = validateBlogPapers(allPosts, allPublications);
if (blogErrors.length > 0) {
  throw new Error(`Blog relations are invalid:\n${blogErrors.join('\n')}`);
}

const pubs = selectHomepage(allPublications);
const projects = featuredProjects(await getCollection('projects'));
const posts = postsByLang(visiblePosts(allPosts), 'en').slice(0, 3);
const publicationNotes = notesByPublication(postsByLang(allPosts, 'en'), pubs);
const workTitles = workTitleMap(allWork);
---
<BaseLayout
  title="Zicong Yang · Applied AI, Computer Vision, and Biomedical Signals"
  description="Personal site of Zicong Yang: applied AI, computer vision, biomedical signal processing, publications, projects, and technical writing."
  profilePage
>
  <Hero />

  {projects.length > 0 && (
    <section class="section container">
      <div class="section-head">
        <h2>Selected Projects</h2>
        <a href={withBase('projects')}>All projects →</a>
      </div>
      <div class="project-grid">
        {projects.map((item) => <ProjectCard item={item} />)}
      </div>
    </section>
  )}

  <ResearchAreas />

  <section class="section container">
    <div class="section-head">
      <h2>Selected Publications</h2>
      <a href={withBase('publications')}>All publications →</a>
    </div>
    <ul class="pub-list">
      {pubs.map((pub) => (
        <PublicationItem pub={pub} workTitles={workTitles} notes={publicationNotes.get(pub.id)} />
      ))}
    </ul>
  </section>

  {posts.length > 0 && (
    <section class="section container">
      <div class="section-head">
        <h2>Latest Writing</h2>
        <a href={withBase('blog')}>All writing →</a>
      </div>
      <PostList posts={posts} />
    </section>
  )}

  <section class="section container">
    <div class="section-head"><h2>Get in touch</h2></div>
    <p class="muted">
      {profile.location} · <a href={`mailto:${profile.email}`}>{profile.email}</a>
    </p>
    <div class="links">
      <a href={withBase('resume')}>Resume →</a>
      <a href={withBase('about')}>About →</a>
      <a href={withBase('contact')}>Contact →</a>
    </div>
  </section>
</BaseLayout>
