---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ResearchAreas from '../components/ResearchAreas.astro';
import PublicationItem from '../components/PublicationItem.astro';
import WorkCard from '../components/WorkCard.astro';
import PostList from '../components/PostList.astro';
import { getCollection, getEntry } from 'astro:content';
import { selectHomepage } from '../lib/publications';
import { visiblePosts } from '../lib/posts';
import { validateRelations } from '../lib/relations';
import { withBase } from '../lib/url';

const allPublications = await getCollection('publications');
const allWork = await getCollection('work');
const relationErrors = validateRelations(allPublications, allWork);
if (relationErrors.length > 0) {
  throw new Error(`Content relations are invalid:\n${relationErrors.join('\n')}`);
}

const pubs = selectHomepage(allPublications);
const work = allWork
  .filter((item) => item.data.kind === 'project')
  .sort((a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id))
  .slice(0, 3);
const posts = visiblePosts(await getCollection('blog')).slice(0, 2);
const about = await getEntry('pages', 'about-en');
const workTitles = Object.fromEntries(allWork.map((item) => [item.id, item.data.title]));
---
<BaseLayout
  title="Zicong Yang · Medical Signal Processing & Computer Vision"
  description="Personal site of Zicong Yang: publications, engineering work, and technical writing."
  profilePage
>
  <Hero />

  <ResearchAreas />

  <section class="section container measure">
    <div class="section-head">
      <h2>Selected Publications</h2>
      <a href={withBase('publications')}>All publications →</a>
    </div>
    <ul class="pub-list">
      {pubs.map((pub) => <PublicationItem pub={pub} workTitles={workTitles} />)}
    </ul>
  </section>

  {work.length > 0 && (
    <section class="section container measure">
      <div class="section-head">
        <h2>Selected Work</h2>
        <a href={withBase('work')}>All work →</a>
      </div>
      <div class="work-grid">{work.map((item) => <WorkCard item={item} />)}</div>
    </section>
  )}

  {posts.length > 0 && (
    <section class="section container measure">
      <div class="section-head">
        <h2>Latest Writing</h2>
        <a href={withBase('blog')}>All writing →</a>
      </div>
      <PostList posts={posts} />
    </section>
  )}

  <section class="section container measure">
    <div class="section-head"><h2>About</h2></div>
    <p class="muted">{about?.data.summary}</p>
    <div class="links">
      <a href={withBase('about')}>More about me →</a>
      <a href={withBase('about')}>CV (print / PDF)</a>
    </div>
  </section>
</BaseLayout>
