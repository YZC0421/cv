---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { projectCategories, sortProjects } from '../../lib/projects';

const projects = sortProjects(await getCollection('projects'));
const usedCategories = projectCategories.filter((category) =>
  projects.some((item) => item.data.category === category.slug)
);
---
<BaseLayout
  title="Projects · Zicong Yang"
  description="Selected AI, data, and research projects."
>
  <div class="container" style="padding-top:48px">
    <h1>Projects</h1>
    <p class="muted">Research and engineering work. Items marked Planned are scaffolds awaiting details.</p>

    {usedCategories.length > 1 && (
      <div class="filters" role="group" aria-label="Filter projects by category">
        <span class="filter-label">Category</span>
        <button type="button" data-category="all" aria-pressed="true">All</button>
        {usedCategories.map((category) => (
          <button type="button" data-category={category.slug} aria-pressed="false">
            {category.label}
          </button>
        ))}
      </div>
    )}

    <div class="project-grid">
      {projects.map((item) => <ProjectCard item={item} />)}
    </div>
    <p id="project-status" class="muted" role="status" aria-live="polite"></p>
  </div>

  <script is:inline>
    (() => {
      const buttons = document.querySelectorAll('.filters button');
      const cards = document.querySelectorAll('.project-card');
      const status = document.getElementById('project-status');
      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const value = btn.dataset.category;
          buttons.forEach((other) => other.setAttribute('aria-pressed', String(other === btn)));
          let visible = 0;
          cards.forEach((card) => {
            card.hidden = value !== 'all' && card.dataset.category !== value;
            if (!card.hidden) visible += 1;
          });
          if (status) {
            status.textContent =
              visible === 0
                ? 'No projects in this category yet.'
                : `Showing ${visible} of ${cards.length} projects.`;
          }
        });
      });
    })();
  </script>
</BaseLayout>
