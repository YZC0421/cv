---
import PageLayout from '../../layouts/PageLayout.astro';
import { getEntry, render } from 'astro:content';
import { withBase } from '../../lib/url';

const entry = await getEntry('pages', 'about-zh');
if (!entry) throw new Error('about-zh.md is missing');
const { Content } = await render(entry);
const enHref = new URL(withBase('about'), Astro.site);
const zhHref = new URL(withBase('about/zh'), Astro.site);
---
<PageLayout
  title="关于 · 杨梓聪"
  description="教育经历、研究方向、技能与联系方式。"
  lang="zh-CN"
  langLink={{ href: withBase('about'), label: 'English', lang: 'en' }}
  heading={entry.data.title}
  updated={entry.data.updated}
  updatedLabel="更新于"
  printLabel="下载 CV (PDF)"
  enHref={enHref}
  zhHref={zhHref}
>
  <Content />
</PageLayout>
